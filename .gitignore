# Build output (cargo, the kernel, initramfs, disk images, ISOs).
# Any folder named target, at any depth: crates outside the workspace
# (ferro-boot) build into their own.
target/
/build/
*.img
*.iso

# Editors and OS clutter.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
heavy-release-backup/
staging/
install-to-os.sh
# Written by the release workflow.
heavy/release
