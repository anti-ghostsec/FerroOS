#!/bin/sh
# ferro-installer: installs a program from a file, the Windows way. Double-
# clicking a .deb or a .tar.gz (and the like) in the file manager runs it in
# a terminal window.
#
#   .deb       installed with apt, which brings in what it needs; its Start
#              menu entry is Debian's own.
#   .tar.*     unpacked into C:\Programs\<Name> (/Programs/<Name>), and the
#              program inside gets a Start menu entry.
#
# Either way it gets a shortcut on the desktop, a Start menu folder of your
# choosing, and is noted in /var/lib/ferro/programs so that Uninstall (right-
# click it in the Start menu) removes exactly what was put there.
#
# What's unpacked is unpacked as you, never as root: an archive built to
# write outside its folder can't reach the system. Only the finished folder
# is moved into /Programs, then given to root so nothing can change it.
# Programs that save beside themselves still can: each account gets its own
# writable layer over the folder (see launcher below).

set -u

PROGRAMS=/Programs
REGISTRY=/var/lib/ferro/programs
ENTRIES=/usr/local/share/applications
LAUNCHERS=/usr/local/lib/ferro-programs

# The launcher for a program in C:\Programs: launcher <id> <name> <dir> <exe>,
# printed. The folder stays as installed (root's, read-only), yet the program
# sees it writable, as many expect (settings, saves, a data folder beside
# itself): what it writes there goes to this account's own layer over it,
# ~/.local/share/ferro-programs/<id>, as Windows does for old programs in
# Program Files. The layer has the folder's folders, so anything can be made
# in any of them, and its own copies of the small settings files, so those can
# be changed. Without bubblewrap (or user namespaces) it just runs.
launcher() {
    q_dir=$(printf '%s' "$3" | sed "s/'/'\\\\''/g")
    q_exe=$(printf '%s' "$4" | sed "s/'/'\\\\''/g")
    cat <<EOF
#!/bin/sh
# Starts $2 in its own folder, which it sees as writable: what it writes
# there is kept in this account's layer over it (ferro-installer explains).
dir='$q_dir'
exe='$q_exe'
layer="\${XDG_DATA_HOME:-\$HOME/.local/share}/ferro-programs/$1"
base=$REGISTRY/$1.base
if command -v bwrap >/dev/null 2>&1 && mkdir -p "\$layer/files" "\$layer/work" 2>/dev/null; then
    # Updated since this account last ran it: the copies of settings files
    # still as an older version shipped them go, so the new version's show
    # through. Ones this account (or the program) changed stay.
    if [ -f "\$base" ] && ! cmp -s "\$base" "\$layer/.base"; then
        (cd "\$layer/files" && sha256sum -c "\$base" 2>/dev/null | sed -n 's/: OK\$//p' | while IFS= read -r f; do rm -f -- "\$f"; done)
        cp "\$base" "\$layer/.base"
    fi
    (cd "\$dir" && find . -mindepth 1 -type d -print0 | (cd "\$layer/files" && xargs -0 -r mkdir -p --))
    (cd "\$dir" && find . -type f -size -1024k \\( -iname '*.ini' -o -iname '*.cfg' -o -iname '*.conf' -o -iname '*.json' \\
        -o -iname '*.xml' -o -iname '*.toml' -o -iname '*.yaml' -o -iname '*.yml' -o -iname '*.txt' \\) -print0 |
        xargs -0 -r cp --update=none --parents -t "\$layer/files" --) 2>/dev/null
    # A trial first: where it can't (no user namespaces), the program still runs.
    if bwrap --dev-bind / / --overlay-src "\$dir" --overlay "\$layer/files" "\$layer/work" "\$dir" true 2>/dev/null; then
        exec bwrap --dev-bind / / --overlay-src "\$dir" --overlay "\$layer/files" "\$layer/work" "\$dir" --chdir "\$dir" -- "\$exe" "\$@"
    fi
fi
cd "\$dir" && exec "\$exe" "\$@"
EOF
}

# The program's own .desktop in its folder, if it has one for <exe>: own_entry
# <dir> <exe>, printed (the first whose Exec= starts that program).
own_entry() {
    want=$(basename "$2")
    find "$1" -maxdepth 3 -type f -name '*.desktop' 2>/dev/null | sort | while IFS= read -r f; do
        run=$(sed -n '/^\[Desktop Entry\]/,/^\[/s/^Exec=//p' "$f" | head -n 1 | awk '{ print $1 }' | tr -d "\"'")
        if [ -n "$run" ] && [ "$(basename "$run")" = "$want" ]; then
            printf '%s\n' "$f"
            break
        fi
    done
}

# The Start menu entry for a program in C:\Programs: entry <name> <launcher>
# <id> <dir> <exe>, printed. From the program's own entry, if it has one, only
# what it opens (so Share and Open With offer it, and files dropped on it are
# passed on), its description and its Start menu folders are kept: it always
# runs through the launcher.
entry() {
    own=$(own_entry "$4" "$5")
    code=""
    [ -n "$own" ] && code=$(sed -n '/^\[Desktop Entry\]/,/^\[/s/^Exec=//p' "$own" | head -n 1 | grep -oE '%[fFuU]' | head -n 1)
    printf '[Desktop Entry]\nType=Application\nName=%s\nExec=%s%s\nX-Ferro-Program=%s\n' "$1" "$2" "${code:+ $code}" "$3"
    [ -n "$own" ] || return 0
    for key in GenericName Comment Categories Keywords MimeType X-Ferro-Share; do
        sed -n '/^\[Desktop Entry\]/,/^\[/p' "$own" | grep -m 1 "^$key=" | tr -d '\r'
    done
    return 0
}

# Run in FerroOS's progress window (FERRO_GUI, set by ferro-programs), a
# question is an `@ferro ...` line it shows as a dialog, and its answer a
# line read back; the window says how it ended, so there's no Enter to press.
GUI=${FERRO_GUI:-}
if [ -n "$GUI" ]; then
    # No terminal for sudo to ask in: the password window instead.
    sudo() { command sudo -A "$@"; }
fi

pause() {
    if [ -z "$GUI" ]; then
        printf '\n Press Enter to close this window. '
        read -r _ || true
    fi
    exit "${1:-0}"
}

fail() {
    if [ -n "$GUI" ]; then
        echo "@ferro fail $*"
        exit 1
    fi
    printf '\n %s\n' "$*"
    pause 1
}

# How it went, shown at the end.
finished() {
    if [ -n "$GUI" ]; then
        echo "@ferro done $*"
    else
        echo " $*"
    fi
    pause 0
}

yes_no() { # yes_no <question>: true for y/yes
    if [ -n "$GUI" ]; then
        echo "@ferro yesno $1"
        read -r a || return 1
        [ "$a" = y ]
        return
    fi
    printf ' %s [y/N] ' "$1"
    read -r a || return 1
    case "$a" in [yY] | [yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

# A Start menu folder: prints one of the folders, or nothing for "as the
# program says".
choose_category() {
    if [ -n "$GUI" ]; then
        # Its answer is what this prints, so the question goes to stderr
        # (which the window reads too).
        echo "@ferro choose Which Start menu folder should it go in?|Let the program decide|Accessories|Internet|Multimedia|System Tools|Development|Games" >&2
        read -r c || c=""
        case "$c" in
        2) echo Accessories ;;
        3) echo Internet ;;
        4) echo Multimedia ;;
        5) echo "System Tools" ;;
        6) echo Development ;;
        7) echo Games ;;
        esac
        return 0
    fi
    echo >&2
    echo " Which Start menu folder should it go in?" >&2
    echo "   1  Accessories     4  System Tools" >&2
    echo "   2  Internet        5  Development" >&2
    echo "   3  Multimedia      6  Games" >&2
    printf ' Choose 1-6, or Enter to let the program decide: ' >&2
    read -r c || c=""
    case "$c" in
    1) echo Accessories ;;
    2) echo Internet ;;
    3) echo Multimedia ;;
    4) echo "System Tools" ;;
    5) echo Development ;;
    6) echo Games ;;
    *) echo "" ;;
    esac
}

# remember_category <entry.desktop> <folder>: what the Start menu shows it in.
remember_category() {
    [ -n "$2" ] || return 0
    folders="$HOME/.config/ferro/start-menu.conf"
    mkdir -p "${folders%/*}"
    base=${1##*/}
    { grep -v "^$base=" "$folders" 2>/dev/null; echo "$base=$2"; } >"$folders.tmp" && mv -f "$folders.tmp" "$folders"
}

# shortcut <entry.desktop> <name>: a copy on the desktop, marked as one you
# made (only those run when double-clicked).
shortcut() {
    desk="$HOME/Desktop"
    mkdir -p "$desk"
    to="$desk/$2.desktop"
    n=2
    while [ -e "$to" ]; do
        to="$desk/$2 ($n).desktop"
        n=$((n + 1))
    done
    cp "$1" "$to" && chmod 755 "$to"
}

# put MODE FILE: what's on stdin, as root's FILE. Written by this account
# first and copied in by sudo itself: sudo at the end of a pipe runs in a
# process of its own, so it would ask for the password all over again.
put() {
    t=$(mktemp) || return 1
    cat >"$t" && sudo install -m "$1" -o root -g root "$t" "$2"
    r=$?
    rm -f "$t"
    return $r
}

# The window manager reads the Start menu and the desktop again.
refresh() {
    command -v ferro-program-props >/dev/null 2>&1 && ferro-program-props --refresh 2>/dev/null
    true
}

# A plain id for a name: letters, digits, dashes.
make_id() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//'
}

# What a program's called without its version or the computers it's for,
# so mygame-1.2 updates mygame-1.0: stem <name>, printed (an id).
stem() {
    id=$(make_id "$1")
    s=$(printf '%s' "$id" | tr '-' '\n' | grep -Evx 'v?[0-9]+[a-z]?|linux|gnu|x86|x64|64|32|amd64|i386|i686|aarch64|arm64|64bit|portable|release|bin' | paste -sd- -)
    printf '%s\n' "${s:-$id}"
}

# An installed program in C:\Programs that <name> is a version of: its id,
# printed, or nothing.
installed_as() {
    want=$(stem "$1")
    for record in "$REGISTRY"/*.conf; do
        [ -f "$record" ] && grep -qx 'kind=folder' "$record" || continue
        had=$(sed -n 's/^name=//p' "$record" | head -n 1)
        if [ "$(make_id "$had")" = "$(make_id "$1")" ] || [ "$(stem "$had")" = "$want" ]; then
            basename "$record" .conf
            return 0
        fi
    done
}

install_deb() {
    file=$1
    pkg=$(dpkg-deb -f "$file" Package 2>/dev/null) || fail "This isn't a package FerroOS can read."
    ver=$(dpkg-deb -f "$file" Version 2>/dev/null)
    arch=$(dpkg-deb -f "$file" Architecture 2>/dev/null)
    desc=$(dpkg-deb -f "$file" Description 2>/dev/null | head -n 1)
    case "$arch" in
    all | "$(dpkg --print-architecture)") ;;
    *) fail "This package is for $arch computers; this one is $(dpkg --print-architecture)." ;;
    esac
    echo " Package:  $pkg $ver"
    echo "           $desc"
    echo
    echo " A program from outside Debian runs with your account's access to your"
    echo " files. Install only ones from people you trust."
    echo
    # Installed already: updated in place. apt keeps its settings, and what
    # it saved in your home folder is never touched.
    have=$(dpkg-query -W -f='${Status} ${Version}' "$pkg" 2>/dev/null | sed -n 's/^install ok installed //p')
    older=""
    if [ -n "$have" ]; then
        if dpkg --compare-versions "$ver" eq "$have"; then
            finished "$pkg $have is installed already; this is the same version, so nothing was changed."
        elif dpkg --compare-versions "$ver" gt "$have"; then
            yes_no "$pkg $have is installed. Update it to $ver? Its settings and what it saved are kept." || fail "Nothing was changed."
        else
            yes_no "$pkg $have is installed, which is newer. Go back to $ver? Its settings and what it saved are kept." || fail "Nothing was changed."
            older=--allow-downgrades
        fi
    else
        yes_no "Install $pkg?" || fail "Nothing was installed."
    fi
    tmp=$(mktemp) || fail "There's no room to install it."
    trap 'rm -f "$tmp"' EXIT
    category=""
    [ -n "$have" ] || category=$(choose_category)
    echo
    # apt brings in whatever the package needs (asks for your password).
    sudo apt-get install -y $older "$file" || fail "It couldn't be installed (see above)."
    if [ -n "$have" ]; then
        refresh
        echo
        finished "$pkg is updated to $ver. Its settings and what it saved are as they were."
    fi

    entries=$(dpkg -L "$pkg" 2>/dev/null | grep -E '^/usr/share/applications/[^/]+\.desktop$')
    if [ -z "$entries" ]; then
        # No Start menu entry of its own: one for the program it put in.
        exe=$(dpkg -L "$pkg" 2>/dev/null | grep -E '^/usr/(local/)?(s?bin|games)/[^/]+$' | head -n 1)
        if [ -n "$exe" ]; then
            entry="$ENTRIES/ferro-prog-$pkg.desktop"
            sudo mkdir -p -m 755 "$ENTRIES"
            printf '[Desktop Entry]\nType=Application\nName=%s\nExec=%s\nX-Ferro-Program=%s\n' "$pkg" "$exe" "$pkg" >"$tmp" &&
                put 644 "$entry" <"$tmp"
            entries=$entry
        fi
    fi
    sudo mkdir -p -m 755 "$REGISTRY" && sudo chmod 711 "${REGISTRY%/*}" && sudo chmod 755 "$REGISTRY"
    printf 'name=%s\nkind=deb\npackage=%s\n' "$pkg" "$pkg" >"$tmp" && put 644 "$REGISTRY/$pkg.conf" <"$tmp"
    for e in $entries; do
        name=$(sed -n 's/^Name=//p' "$e" | head -n 1)
        remember_category "$e" "$category"
        shortcut "$e" "${name:-$pkg}"
    done
    refresh
    echo
    if [ -n "$entries" ]; then
        finished "$pkg is installed. It's in the Start menu (Programs) and on the desktop."
    else
        finished "$pkg is installed. It has no window of its own: run it in a Command Prompt."
    fi
}

# The programs in a folder, likeliest first: executable files that are
# programs (not libraries), named like the folder, not too deep in.
find_programs() { # find_programs <dir> <name>
    want=$(make_id "$2" | cut -d- -f1)
    find "$1" -maxdepth 4 -type f -perm -u+x ! -name '*.so' ! -name '*.so.*' 2>/dev/null | while read -r f; do
        kind=$(file -b "$f" 2>/dev/null)
        case "$kind" in
        *ELF*executable* | *ELF*pie* | *script*) ;;
        *) continue ;;
        esac
        base=$(make_id "$(basename "$f")")
        depth=$(printf '%s' "${f#"$1"/}" | tr -cd / | wc -c)
        # Named like the program counts most, then being near the top.
        score=$((depth * 5))
        case "$base" in "$want"*) ;; *) score=$((score + 15)) ;; esac
        case "$kind" in *script*) score=$((score + 3)) ;; esac
        printf '%d\t%s\n' "$score" "$f"
    done | sort -n | cut -f2-
}

# unpack_app <file>: unpacked as this account into $work; the program's
# folder in it is $app.
unpack_app() {
    work=$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/ferro-install.XXXXXX" 2>/dev/null) || {
        mkdir -p "$HOME/.cache" && work=$(mktemp -d "$HOME/.cache/ferro-install.XXXXXX")
    } || fail "There's no room to unpack it."
    trap 'rm -rf "$work"' EXIT
    echo " Unpacking..."
    tar -xf "$1" -C "$work" --no-same-owner || fail "It couldn't be unpacked: the archive may be damaged."
    # One folder inside (as most have): that's the program's folder.
    set -- "$work"/* "$work"/.[!.]*
    inside=""
    count=0
    for f in "$@"; do
        [ -e "$f" ] || continue
        count=$((count + 1))
        inside=$f
    done
    if [ "$count" -eq 1 ] && [ -d "$inside" ]; then app=$inside; else app=$work; fi
}

# The small settings files a launcher gives each account a copy of (see
# launcher), with their checksums: settings_sums <dir>, printed.
settings_sums() {
    (cd "$1" && find . -type f -size -1024k \( -iname '*.ini' -o -iname '*.cfg' -o -iname '*.conf' -o -iname '*.json' \
        -o -iname '*.xml' -o -iname '*.toml' -o -iname '*.yaml' -o -iname '*.yml' -o -iname '*.txt' \) -print0 |
        xargs -0 -r sha256sum --)
}

# update_folder <file> <id>: the program installed as <id> replaced by the
# one in <file>, where it was, under the same name, launcher and Start menu
# entry. Nothing in anyone's home folder is touched: what it saved in its
# folder (each account's layer over it) and in its own settings stays.
update_folder() {
    record="$REGISTRY/$2.conf"
    name=$(sed -n 's/^name=//p' "$record" | head -n 1)
    dest=$(sed -n 's/^dir=//p' "$record")
    launcher=$(sed -n 's/^launcher=//p' "$record")
    entry=$(sed -n 's/^entry=//p' "$record")
    # Only ever what the installer made.
    case "$dest" in "$PROGRAMS"/?*) ;; *) fail "The record for '$name' doesn't name a folder in C:\\Programs; nothing was changed." ;; esac
    [ -d "$dest" ] || fail "'$name' isn't in C:\\Programs any more: uninstall it (Start menu, right-click it), then install this."
    unpack_app "$1"
    # The program it started before, if this one has it in the same place.
    was=$(sed -n "s/^exe='\(.*\)'\$/\1/p" "$launcher" 2>/dev/null | sed "s/'\\\\''/'/g")
    rel=${was#"$dest"/}
    if [ -z "$was" ] || [ "$rel" = "$was" ] || [ ! -f "$app/$rel" ] || [ ! -x "$app/$rel" ]; then
        exe=$(find_programs "$app" "$name" | head -n 1)
        [ -n "$exe" ] || fail "No program was found in it. It may need building, or may not be a program at all."
        rel=${exe#"$app"/}
    fi
    echo
    echo " Updating C:\\Programs\\${dest#"$PROGRAMS"/} (asks for your password)..."
    # The settings files the version going out came with: each account's
    # unchanged copies of them give way to the new version's (see launcher).
    settings_sums "$dest" >"$work/.sums"
    { cat "$REGISTRY/$2.base" 2>/dev/null; cat "$work/.sums"; } | sort -u >"$work/.base"
    sudo rm -rf -- "$dest.new" "$dest.old"
    sudo cp -a "$app" "$dest.new" || { sudo rm -rf -- "$dest.new"; fail "It couldn't be copied into C:\\Programs; '$name' is as it was."; }
    sudo chown -R root:root "$dest.new" && sudo chmod -R go-w,a+rX "$dest.new"
    put 644 "$REGISTRY/$2.base" <"$work/.base" || fail "It couldn't be noted; '$name' is as it was."
    # Swapped in at once: the old one out of the way, the new one in its place.
    sudo mv -- "$dest" "$dest.old" || fail "It couldn't be updated; '$name' is as it was."
    if ! sudo mv -- "$dest.new" "$dest"; then
        sudo mv -- "$dest.old" "$dest"
        fail "It couldn't be updated; '$name' is as it was."
    fi
    sudo rm -rf -- "$dest.old"
    launcher "$2" "$name" "$dest" "$dest/$rel" >"$work/.launcher" &&
        put 755 "$launcher" <"$work/.launcher" || fail "Its launcher couldn't be remade."
    entry "$name" "$launcher" "$2" "$dest" "$dest/$rel" >"$work/.entry" &&
        put 644 "$entry" <"$work/.entry" || fail "Its Start menu entry couldn't be remade."
    refresh
    echo
    finished "'$name' is updated. Its settings and what it saved are as they were; its Start menu entry and shortcuts open the new one."
}

install_folder() {
    file=$1
    base=$(basename "$file")
    guess=$(printf '%s' "$base" | sed -E 's/\.(tar\.(gz|xz|bz2|zst)|tgz|txz|tbz2|tar)$//')
    echo " Archive: $base"
    echo
    if [ -n "$GUI" ]; then
        echo "@ferro choose What should be done with $base?|Install it as a program (into C:\\Programs, with a Start menu entry)|Just unpack it here"
        read -r what || what=0
        case "$what" in 1) what=i ;; 2) what=u ;; *) what=c ;; esac
    else
        echo "   I  Install it as a program (into C:\\Programs, with a Start menu entry)"
        echo "   U  Just unpack it here"
        echo "   C  Cancel"
        printf ' Choose: '
        read -r what || what=c
    fi
    case "$what" in
    [iI]) ;;
    [uU])
        dir=$(dirname "$file")
        tar -xf "$file" -C "$dir" --no-same-owner || fail "It couldn't be unpacked: the archive may be damaged."
        # Nothing unpacked is runnable: a double-click runs only what has an
        # execute bit, and someone else's archive mustn't grant it.
        tar -tf "$file" 2>/dev/null | while IFS= read -r p; do
            [ -f "$dir/$p" ] && [ ! -L "$dir/$p" ] && chmod a-x -- "$dir/$p"
        done
        finished "Unpacked into $dir."
        ;;
    *) fail "Nothing was done." ;;
    esac

    # A newer (or older) version of a program installed here: updated in
    # place, or put in beside it.
    had=$(installed_as "$guess")
    if [ -n "$had" ]; then
        hadname=$(sed -n 's/^name=//p' "$REGISTRY/$had.conf" | head -n 1)
        if [ -n "$GUI" ]; then
            echo "@ferro choose '$hadname' is installed already. What should be done?|Update it with this one (its settings and saves are kept)|Install this as another program"
            read -r how || how=0
            case "$how" in 1) how=u ;; 2) how=a ;; *) how=c ;; esac
        else
            echo " '$hadname' is installed already."
            echo "   U  Update it with this one (its settings and saves are kept)"
            echo "   A  Install this as another program"
            echo "   C  Cancel"
            printf ' Choose: '
            read -r how || how=c
        fi
        case "$how" in
        [uU]) update_folder "$file" "$had" ;;
        [aA]) ;;
        *) fail "Nothing was changed." ;;
        esac
    fi

    if [ -n "$GUI" ]; then
        echo "@ferro text Name for it in the Start menu:|$guess"
        read -r name || name="!"
        [ "$name" = "!" ] && fail "Nothing was installed."
        name=${name#=}
    else
        printf ' Name for it [%s]: ' "$guess"
        read -r name || name=""
    fi
    name=$(printf '%s' "${name:-$guess}" | tr -d '/\n' | sed 's/^\.*//')
    [ -n "$name" ] || fail "It needs a name."
    id=$(make_id "$name")
    [ -n "$id" ] || fail "It needs a name with letters or digits in it."
    dest="$PROGRAMS/$name"
    if [ -e "$dest" ] || [ -e "$REGISTRY/$id.conf" ]; then
        if [ -f "$REGISTRY/$id.conf" ] && grep -qx 'kind=folder' "$REGISTRY/$id.conf" &&
            [ "$(sed -n 's/^dir=//p' "$REGISTRY/$id.conf")" = "$dest" ]; then
            yes_no "'$name' is installed already. Update it with this one? Its settings and what it saved are kept." ||
                fail "Nothing was changed."
            update_folder "$file" "$id"
        fi
        fail "Something called '$name' is in C:\\Programs already, but not as a program installed here."
    fi

    unpack_app "$file"

    programs=$(find_programs "$app" "$name")
    [ -n "$programs" ] || fail "No program was found in it. It may need building, or may not be a program at all."
    n=$(printf '%s\n' "$programs" | wc -l)
    exe=$(printf '%s\n' "$programs" | head -n 1)
    if [ "$n" -gt 1 ]; then
        if [ -n "$GUI" ]; then
            printf '%s\n' "$programs" | head -n 9 | awk -v base="$app/" '
                { if (index($0, base) == 1) $0 = substr($0, length(base) + 1); gsub(/\|/, "/"); line = line "|" $0 }
                END { print "@ferro choose It has more than one program. Which is the one to start?" line }'
            read -r k || k=0
            [ "$k" = 0 ] && fail "Nothing was installed."
        else
            echo
            echo " It has more than one program. Which is the one to start?"
            printf '%s\n' "$programs" | head -n 9 | awk -v base="$app/" '{ if (index($0, base) == 1) $0 = substr($0, length(base) + 1); printf "   %d  %s\n", NR, $0 }'
            printf ' Choose 1-%d [1]: ' "$([ "$n" -gt 9 ] && echo 9 || echo "$n")"
            read -r k || k=1
        fi
        case "$k" in [1-9]) exe=$(printf '%s\n' "$programs" | sed -n "${k}p") ;; esac
        [ -n "$exe" ] || exe=$(printf '%s\n' "$programs" | head -n 1)
    fi
    rel=${exe#"$app"/}
    category=$(choose_category)
    echo
    echo " Installing into C:\\Programs\\$name (asks for your password)..."
    # Root's umask (077) would leave these root-only: everyone must read them.
    sudo mkdir -p -m 755 "$PROGRAMS" "$REGISTRY" "$LAUNCHERS" "$ENTRIES" || fail "It couldn't be installed."
    sudo chmod 711 "${REGISTRY%/*}"
    sudo chmod 755 "$PROGRAMS" "$REGISTRY" "$LAUNCHERS" "$ENTRIES"
    sudo cp -a "$app" "$dest" || fail "It couldn't be copied into C:\\Programs."
    # The system's now: nobody (and no program) can change it underneath, and
    # everyone can read and run it.
    sudo chown -R root:root "$dest" && sudo chmod -R go-w,a+rX "$dest"

    launcher="$LAUNCHERS/$id"
    entry="$ENTRIES/ferro-prog-$id.desktop"
    # Noted first, so that whatever fails below, Uninstall can clear it up.
    printf 'name=%s\nkind=folder\ndir=%s\nlauncher=%s\nentry=%s\n' "$name" "$dest" "$launcher" "$entry" >"$work/.conf" &&
        put 644 "$REGISTRY/$id.conf" <"$work/.conf" || fail "It couldn't be noted as installed."
    launcher "$id" "$name" "$dest" "$dest/$rel" >"$work/.launcher" &&
        put 755 "$launcher" <"$work/.launcher" || fail "Its launcher couldn't be made."
    entry "$name" "$launcher" "$id" "$dest" "$dest/$rel" >"$work/.entry" &&
        put 644 "$entry" <"$work/.entry" || fail "Its Start menu entry couldn't be made."

    remember_category "$entry" "${category:-Accessories}"
    shortcut "$entry" "$name" || echo " (The desktop shortcut couldn't be made.)"
    refresh
    echo
    finished "'$name' is installed: it's in the Start menu (Programs) and on the desktop. To remove it, right-click it there, then Uninstall."
}

# ferro-update remakes older launchers with this.
if [ "${1:-}" = --launcher ] && [ $# -eq 5 ]; then
    launcher "$2" "$3" "$4" "$5"
    exit
fi
# And entries made before they kept what the program opens.
if [ "${1:-}" = --entry ] && [ $# -eq 6 ]; then
    entry "$2" "$3" "$4" "$5" "$6"
    exit
fi

[ $# -ge 1 ] || {
    echo "usage: ferro-installer FILE (.deb, .tar.gz, .tar.xz, .tgz...)" >&2
    exit 2
}
file=$(readlink -f -- "$1") || fail "'$1' isn't there."
[ -f "$file" ] || fail "'$1' isn't there."
echo
echo " FerroOS Program Installer"
echo " ========================="
echo
case "$(printf '%s' "$file" | tr 'A-Z' 'a-z')" in
*.deb) install_deb "$file" ;;
*.tar.gz | *.tgz | *.tar.xz | *.txz | *.tar.bz2 | *.tbz2 | *.tar.zst | *.tar) install_folder "$file" ;;
*) fail "FerroOS installs programs from .deb and .tar.gz (.tar.xz, .tgz...) files." ;;
esac
