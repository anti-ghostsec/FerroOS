#!/bin/sh
# ferro-terminal: the Command Prompt on FerroOS Heavy. A plain Linux terminal
# running bash (a login shell, so /etc/profile and ~/.profile apply), in the
# green-on-black look. Opens in the current folder, or the one given.
# Everything typed goes straight to bash: ping, nslookup, apt, pipes, scripts.

#
#   ferro-terminal [FOLDER]            a Command Prompt, opened in FOLDER
#   ferro-terminal -e PROGRAM [ARGS]   runs PROGRAM in a terminal window
#                                      (Uninstall, Add Programs, installers)

SH=/bin/bash
[ -x "$SH" ] || SH=/bin/sh

if [ "${1:-}" = "-e" ]; then
    shift
    [ $# -gt 0 ] || exit 2
    title=$(basename "$1")
    if command -v lxterminal >/dev/null 2>&1; then
        # lxterminal takes the command as one line: each argument quoted.
        line=""
        for a in "$@"; do
            line="$line '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"
        done
        exec lxterminal -t "$title" --geometry=90x28 -e "$line"
    fi
    exec xterm -T "$title" -geometry 90x28 -bg "#000000" -fg "#33FF33" -cr "#33FF33" \
        -fa "DejaVu Sans Mono" -fs 10 -e "$@"
fi

[ -n "$1" ] && cd "$1" 2>/dev/null

if command -v lxterminal >/dev/null 2>&1; then
    exec lxterminal -t "Terminal" --geometry=80x24 --working-directory="$PWD" -e "$SH -l"
fi
exec xterm -T "Terminal" -bg "#000000" -fg "#33FF33" -cr "#33FF33" \
    -fa "DejaVu Sans Mono" -fs 10 -e "$SH" -l
