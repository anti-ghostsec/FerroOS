#!/bin/sh
# Says whether a password is an account's: the name and the password come
# on two lines of standard input, and the answer is the exit status.
# ferro-logon asks this before letting anyone in, at the logon screen and
# at the lock screen.
#
# The checking itself is the system's own (PAM, through `su`), so locked
# and expired accounts are refused the same as everywhere else. `su` is
# run as nobody: run as root it wouldn't ask for a password at all.

# The lock screen runs as the person logged on; checking (and the duress
# PIN's erasing) needs root. harden.sh lets the sudo group run exactly this.
[ "$(id -u)" = 0 ] || exec sudo -n /usr/local/lib/ferro-heavy/check-password

IFS= read -r name || exit 1
IFS= read -r password || exit 1

# Through sudo (the lock screen), only the account of whoever asked: this
# must not become a way to test passwords for anyone else.
if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_UID:-0}" != 0 ] && [ "$name" != "$SUDO_USER" ]; then
    sleep 2
    exit 1
fi

# A name that isn't a person's account: refused after the same wait as a
# first wrong answer, before taking any lock.
case "$name" in '' | *[!a-z0-9_-]*) sleep 2; exit 1 ;; esac
uid=$(id -u "$name" 2>/dev/null) || { sleep 2; exit 1; }
[ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || { sleep 2; exit 1; }
[ -n "$password" ] || { sleep 2; exit 1; }

# Each account has its own count, kept apart for programs asking through
# sudo and for the logon screen (root, not through sudo): every wrong
# answer in a row pushes the next allowed try further away (2 s, 4 s,
# 8 s ... up to a minute), so asking many times at once guesses no
# faster. The lock is held only for the check itself, never for the
# waiting, so one account's wrong answers never hold up another's, and a
# program guessing at the person's own password can't keep the logon
# screen waiting.
case "${SUDO_UID:-}" in '' | 0) by=screen ;; *) by=sudo ;; esac
STATE=/run/ferro/check-password
mkdir -p "$STATE" && chmod 700 "$STATE" || exit 1
LOCK=$STATE/$uid.$by.lock
FAILS=$STATE/$uid.$by.fails
exec 9>"$LOCK" || exit 1

# The count and when the next try is allowed: "<fails> <seconds>".
while :; do
    flock 9 || exit 1
    read -r fails next 2>/dev/null <"$FAILS"
    case "$fails" in '' | *[!0-9]*) fails=0 ;; esac
    case "$next" in '' | *[!0-9]*) next=0 ;; esac
    now=$(date +%s)
    [ "$now" -ge "$next" ] && break
    flock -u 9
    sleep $((next - now))
done

refuse() {
    fails=$((fails + 1))
    delay=2 i=1
    while [ $i -lt "$fails" ] && [ $delay -lt 60 ]; do
        delay=$((delay * 2)) i=$((i + 1))
    done
    [ $delay -gt 60 ] && delay=60
    echo "$fails $(($(date +%s) + delay))" >"$FAILS"
    flock -u 9
    sleep "$delay"
    exit 1
}

# Whether a password is the duress PIN. /etc/ferro/duress.hash holds
# "argon2id <time> <memory> <salt> <hash>": slow and salted, so a copy of
# the disk doesn't give the PIN away. Nothing else is accepted.
is_duress() {
    # Only root's own: one anyone else could have put there isn't the PIN.
    for f in /etc/ferro /etc/ferro/duress.hash; do
        [ "$(stat -c %u "$f" 2>/dev/null)" = 0 ] && [ $((0$(stat -c %a "$f") & 022)) = 0 ] || return 1
    done
    read -r kind t m salt want </etc/ferro/duress.hash
    [ "$kind" = argon2id ] || return 1
    got=$(printf '%s' "$1" | argon2 "$salt" -id -t "$t" -m "$m" -p 1 -l 32 -r 2>/dev/null)
    [ -n "$got" ] && [ "$got" = "$want" ]
}

# The duress PIN: destroys the system disk's encryption keys, so nothing on
# it can be decrypted again, and switches off at once. (At startup,
# unlock-disk does the same for the disk passphrase prompt.) Only the disk
# FerroOS runs from: the device under the opened ferro-system volume, never
# another disk or USB stick.
if is_duress "$password"; then
    dev=$(cryptsetup status ferro-system 2>/dev/null | awk '$1 == "device:" { print $2 }')
    [ -b "$dev" ] || dev=/dev/disk/by-partlabel/ferro-system
    if [ -b "$dev" ]; then
        cryptsetup -q erase "$dev" >/dev/null 2>&1
        dd if=/dev/zero of="$dev" bs=1M count=16 conv=fsync status=none 2>/dev/null
    fi
    sync
    echo 3 >/proc/sys/vm/drop_caches 2>/dev/null
    echo o >/proc/sysrq-trigger 2>/dev/null
    exit 1
fi

printf '%s\n' "$password" |
    setpriv --reuid nobody --regid nogroup --clear-groups su "$name" -c true >/dev/null 2>&1 || refuse
rm -f "$FAILS"
# The right password: USB devices plugged in from now on are used again
# (Win+L stopped that, see ferro-usb-lock). Only here, so no program can
# undo the lock without the password.
if [ -e /run/ferro/usb-locked ] && [ -x /usr/local/sbin/ferro-usb-lock ]; then
    /usr/local/sbin/ferro-usb-lock unlock >/dev/null 2>&1
fi
exit 0
