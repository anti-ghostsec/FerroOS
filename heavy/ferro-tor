#!/bin/sh
# ferro-tor: the Tor switch on FerroOS Heavy (Network > VPN & Tor).
#
#   ferro-tor on [bridges]   send everything through Tor
#   ferro-tor off            back to the normal connection
#   ferro-tor restore        at startup: turn Tor back on if it was left on
#   ferro-tor reapply        after the firewall reloads: its rules again
#   ferro-tor status         what the switch is doing, and the exit address
#   ferro-tor check          (run by ferro-tor itself) wait for Tor, show progress
#
# "On" means every program, not only ones set up with a proxy: firewall rules
# send all TCP traffic into Tor's transparent port and all DNS into Tor's DNS
# port, and drop what Tor can't carry (UDP, ICMP, IPv6), so nothing leaks out
# around it. The rules go in before Tor is connected, so until it is, nothing
# gets out at all. Only Tor's own account (debian-tor) reaches the outside
# directly. It fails closed: if Tor or its rules can't be set up, the internet
# is blocked until Tor is switched off.
#
# Runs as root: the Network window calls it through sudo (see harden.sh).

set -u

TORRC=/etc/tor/torrc
REMEMBER=/var/lib/ferro/tor-on
RUN=/run/ferro
STATUS=$RUN/tor-status
CHECKER=$RUN/tor-check.pid
RESOLVED_DROPIN=/run/systemd/resolved.conf.d/60-ferro-tor.conf
CHOICES=/ProgramData/ferro/choices.conf
# Left when Tor wouldn't run in its sandbox here, so it isn't tried again
# with this version of Tor. It holds that version: an updated Tor tries again.
NO_SANDBOX=/var/lib/ferro/tor-no-sandbox
TRANS_PORT=9040
DNS_PORT=9053

[ "$(id -u)" = 0 ] || exec sudo -n "$0" "$@"

set_status() { # set_status <state> <detail>
    mkdir -p "$RUN" && chmod 755 "$RUN"
    printf 'state=%s\ndetail=%s\n' "$1" "$2" >"$STATUS.tmp" && chmod 644 "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
}

BUILTIN_BRIDGES=/usr/local/share/ferro/tor-bridges.conf
VALID_BRIDGE='^([A-Za-z0-9_]+ )?[0-9A-Fa-f.:]+:[0-9]+( [A-Za-z0-9 .:=/,_@+-]*)?$'
# The snowflake bridge's identity before the Tor Project replaced it: a line
# naming it reaches a proxy ("connected to a relay") and goes no further.
STALE_BRIDGE=2B280B23DD74683028100AB73E41B3BB52F4F354

# Bridge lines added by hand (in the Network window's choices, one
# "bridge <line>" each). Only characters a bridge line uses get through, so
# nothing else lands in torrc. /ProgramData is shared by every account: the
# file counts only if root or an administrator (sudo group) owns it and
# nobody else can change it, so another account can't plant bridges.
own_bridge_lines() {
    [ -f "$CHOICES" ] && [ ! -L "$CHOICES" ] || return 0
    owner=$(stat -c %U "$CHOICES" 2>/dev/null) || return 0
    perms=$(stat -c %a "$CHOICES" 2>/dev/null) || return 0
    case "$perms" in *[2367]? | *[2367]) return 0 ;; esac
    [ "$owner" = root ] || id -nG "$owner" 2>/dev/null | grep -qw sudo || return 0
    sed -n 's/^[[:space:]]*bridge[[:space:]]\{1,\}//p' "$CHOICES" | grep -v "$STALE_BRIDGE" | grep -E "$VALID_BRIDGE"
}

# The bridges to use: your own, or else FerroOS's built-in set (the Tor
# Project's current one, shipped with FerroOS). Debian's snowflake-client
# takes one front=, not a fronts= list.
bridge_lines() {
    lines=$(own_bridge_lines)
    [ -n "$lines" ] || lines=$(grep -v '^[[:space:]]*#' "$BUILTIN_BRIDGES" 2>/dev/null | grep -E "$VALID_BRIDGE")
    printf '%s\n' "$lines" | sed 's/ fronts=\([^, ]*\)[^ ]*/ front=\1/' | grep -E "$VALID_BRIDGE"
}

write_torrc() { # write_torrc <use bridges: 0|1>
    if [ -f "$NO_SANDBOX" ] && [ "$(cat "$NO_SANDBOX")" != "$(tor_version)" ]; then
        rm -f "$NO_SANDBOX"
    fi
    {
        echo "# Written by ferro-tor each time Tor is switched on."
        # Stream isolation: each website (address and port) gets circuits of
        # its own, so an exit relay, or one site, can't link what else this
        # machine does. 9150 is for Tor Browser (ferro-torbrowser), which
        # also keeps each site's tabs apart by itself.
        echo "SocksPort 127.0.0.1:9050 IsolateDestAddr IsolateDestPort"
        echo "SocksPort 127.0.0.1:9150 IsolateDestAddr IsolateDestPort"
        echo "TransPort 127.0.0.1:$TRANS_PORT IsolateClientAddr IsolateDestAddr IsolateDestPort"
        echo "DNSPort 127.0.0.1:$DNS_PORT"
        # Guard discovery (finding the relay that sees this machine's real
        # address, by making Tor build circuits until an attacker's relay is
        # next to it): fixed middle relays for onion-site circuits. On by
        # default in current Tor; said here so an old default can't undo it.
        echo "VanguardsLiteEnabled 1"
        # Padding between this machine and its guard even if the network's
        # consensus would turn it down: the connection records an ISP keeps
        # then show less of when, and how much, went through Tor.
        echo "ConnectionPadding 1"
        echo "AvoidDiskWrites 1"
        # Tor's own seccomp sandbox: a flaw in Tor can do far less. Tor
        # refuses it with bridges (it can't start their transport programs
        # then), and ferro-tor check turns it off again if Tor dies with it.
        [ "$1" = 1 ] || [ -f "$NO_SANDBOX" ] || echo "Sandbox 1"
        # .onion names resolve to addresses in this range, which the firewall
        # sends into TransPort like everything else.
        echo "AutomapHostsOnResolve 1"
        echo "AutomapHostsSuffixes .onion,.exit"
        echo "VirtualAddrNetworkIPv4 127.192.0.0/10"
        echo "ClientUseIPv6 0"
        if [ "$1" = 1 ]; then
            lines=$(bridge_lines)
            if [ -n "$lines" ]; then
                echo "UseBridges 1"
                if [ -x /usr/bin/lyrebird ]; then
                    echo "ClientTransportPlugin meek_lite,obfs4 exec /usr/bin/lyrebird"
                elif [ -x /usr/bin/obfs4proxy ]; then
                    echo "ClientTransportPlugin meek_lite,obfs4 exec /usr/bin/obfs4proxy"
                fi
                [ -x /usr/bin/snowflake-client ] && echo "ClientTransportPlugin snowflake exec /usr/bin/snowflake-client"
                [ -x /usr/bin/webtunnel-client ] && echo "ClientTransportPlugin webtunnel exec /usr/bin/webtunnel-client"
                echo "$lines" | sed 's/^/Bridge /'
            fi
        fi
    } >"$TORRC.tmp" && chmod 644 "$TORRC.tmp" && mv -f "$TORRC.tmp" "$TORRC"
}

firewall_on() {
    nft -f - <<EOF
table inet ferro_tor
delete table inet ferro_tor
table inet ferro_tor {
    chain nat_out {
        type nat hook output priority -100; policy accept;
        meta skuid "debian-tor" return
        ip daddr 127.192.0.0/10 meta l4proto tcp redirect to :$TRANS_PORT
        meta nfproto ipv4 udp dport 53 redirect to :$DNS_PORT
        ip daddr 127.0.0.0/8 return
        meta nfproto ipv4 meta l4proto tcp redirect to :$TRANS_PORT
    }
    chain filter_out {
        type filter hook output priority filter; policy drop;
        meta skuid "debian-tor" accept
        oifname "lo" accept
        ip daddr 127.0.0.0/8 accept
        # Getting an address from the router, and the neighbour discovery
        # IPv6 needs on the link itself. Nothing else leaves directly: not
        # even to the local network, where a proxy or the router could
        # still pass it on.
        udp sport 68 udp dport 67 accept
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        meta l4proto tcp reject with tcp reset
        reject
    }
}
EOF
}

# When the rules above can't go in (Tor's account is missing, say): block
# everything but this machine talking to itself.
firewall_block_all() {
    nft -f - <<EOF
table inet ferro_tor
delete table inet ferro_tor
table inet ferro_tor {
    chain filter_out {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
    }
}
EOF
}

# Tor is wanted, so either traffic goes through Tor or it goes nowhere. If
# even the blocking rules can't go in, networking is switched off outright.
lock_down() {
    firewall_on && return 0
    firewall_block_all && return 1
    nmcli networking off >/dev/null 2>&1
    for dev in /sys/class/net/*; do
        [ "${dev##*/}" = lo ] || ip link set "${dev##*/}" down 2>/dev/null
    done
    return 1
}

firewall_off() {
    nft delete table inet ferro_tor 2>/dev/null || true
}

# DNS: systemd-resolved asks Tor and nobody else, and doesn't try DNSSEC or
# DNS-over-TLS, which Tor's DNS port can't do.
resolver_on() {
    mkdir -p "${RESOLVED_DROPIN%/*}"
    # The empty assignments first: these lists add up across files, and
    # only Tor may be asked.
    printf '[Resolve]\nDNS=\nDNS=127.0.0.1:%s\nFallbackDNS=\nDomains=~.\nDNSOverTLS=no\nDNSSEC=no\nCache=no\n' "$DNS_PORT" >"$RESOLVED_DROPIN"
    systemctl --no-block restart systemd-resolved 2>/dev/null || true
}

resolver_off() {
    rm -f "$RESOLVED_DROPIN"
    systemctl --no-block restart systemd-resolved 2>/dev/null || true
}

# The checker runs as a service of its own (ferro-tor-check), so nothing
# that started it (sudo, the Network window, the session) can stop it.
CHECK_UNIT=ferro-tor-check

stop_checker() {
    systemctl stop "$CHECK_UNIT" 2>/dev/null
    [ -f "$CHECKER" ] && kill "$(cat "$CHECKER")" 2>/dev/null
    rm -f "$CHECKER"
}

start_checker() {
    stop_checker
    systemctl reset-failed "$CHECK_UNIT" 2>/dev/null
    if ! systemd-run --quiet --collect --unit="$CHECK_UNIT" /usr/local/sbin/ferro-tor check 2>/dev/null; then
        setsid "$0" check </dev/null >/dev/null 2>&1 &
        echo $! >"$CHECKER"
    fi
}

# What Tor itself last said about connecting: "45 (Asking for relay
# descriptors)", from its log.
tor_progress() {
    journalctl -u tor@default -u tor --since "-30min" -o cat --no-pager -n 300 2>/dev/null |
        sed -n 's/.*Bootstrapped \([0-9]*%\)[^:]*: *\(.*\)/\1 (\2)/p' | tail -n 1
}

# Whether Tor has said this machine's clock is wrong. It refuses the
# network's directory when the time is hours off, as it is when Windows
# on the same machine keeps the hardware clock in local time.
tor_clock_skew() {
    journalctl -u tor@default -u tor --since "-30min" -o cat --no-pager -n 300 2>/dev/null |
        grep -i -E 'clock (is|skew)|our clock|skewed' | tail -n 1
}

# set_clock_from_tor <log line>: Tor's complaint about the clock carries
# the network's own time: "Our clock is 5 hours, 2 minutes behind the time
# published in the consensus network status document (2026-10-24 12:00:00
# UTC)". A consensus is published on the hour and is the newest for an
# hour, so half an hour after it is within half an hour of now: close
# enough for Tor. Or, from a relay, "our clock is ahead by 5 hours, 2
# minutes". Nothing leaves the machine for this, so nothing leaks around
# Tor. Prints nothing; fails if the line gives no time.
set_clock_from_tor() {
    when=$(printf '%s\n' "$1" | sed -n 's/.*consensus[^(]*(\([0-9][0-9-]* [0-9:]*\) UTC).*/\1/p')
    if [ -n "$when" ]; then
        t=$(date -u -d "$when" +%s 2>/dev/null) || return 1
        date -u -s "@$((t + 1800))" >/dev/null 2>&1
        return
    fi
    rel=$(printf '%s\n' "$1" | grep -o -i -E '(ahead|behind) by [0-9a-z, ]+' | head -n 1)
    [ -n "$rel" ] || return 1
    secs=0
    for unit in day hour minute second; do
        n=$(printf '%s\n' "$rel" | grep -o -E "[0-9]+ $unit" | grep -o -E '^[0-9]+')
        case $unit in day) m=86400 ;; hour) m=3600 ;; minute) m=60 ;; second) m=1 ;; esac
        secs=$((secs + ${n:-0} * m))
    done
    [ "$secs" -gt 0 ] || return 1
    case "$rel" in [Aa]head*) secs=$((0 - secs)) ;; esac
    date -u -s "@$(($(date -u +%s) + secs))" >/dev/null 2>&1
}

# Once Tor works: the exact time, from the Date of an answer that came
# through Tor (from a server whose certificate checked out).
refine_clock() {
    d=$(curl -sI -m 15 --socks5-hostname 127.0.0.1:9050 https://check.torproject.org/ 2>/dev/null | sed -n 's/^[Dd]ate: *//p' | tr -d '\r')
    [ -n "$d" ] || return 0
    t=$(date -u -d "$d" +%s 2>/dev/null) || return 0
    off=$((t - $(date -u +%s)))
    [ "${off#-}" -gt 30 ] && date -u -s "@$t" >/dev/null 2>&1
    return 0
}

tor_version() {
    tor --version 2>/dev/null | head -n 1
}

# Whether Tor's sandbox is what stopped it: Tor says so in its log, or it
# was killed for a system call the sandbox forbids (SIGSYS). Any other
# reason Tor stops (a bad network, memory, a crash someone caused) must
# not be a way to turn the sandbox off.
tor_sandbox_failed() {
    journalctl -u tor@default -u tor --since "-30min" -o cat --no-pager -n 100 2>/dev/null |
        grep -q -i -E '\(Sandbox\)|sandbox (is not|failed|error)|error[^.]*sandbox|seccomp|status=31/SYS'
}

# Whether Tor has stopped by itself: failed, or waiting for systemd to start
# it again. (Still starting doesn't count.)
tor_died() {
    st=$(systemctl show -p ActiveState -p SubState --value tor@default 2>/dev/null | tr '\n' ' ')
    case "$st" in
    failed* | inactive* | *auto-restart*) return 0 ;;
    esac
    return 1
}

# check: waits for Tor to connect, asking the Tor Project whether a request
# really came out of Tor, and shows how far along it is meanwhile. When Tor
# says the clock is wrong, sets it from Tor's own report and starts Tor
# again.
check() {
    i=0
    fixed=""
    fixes=0
    while [ $i -lt 120 ]; do
        sleep 2
        i=$((i + 1))
        reply=$(curl -s -m 15 --socks5-hostname 127.0.0.1:9050 https://check.torproject.org/api/ip 2>/dev/null)
        case "$reply" in
        *'"IsTor":true'*)
            refine_clock
            ip=$(printf '%s' "$reply" | sed -n 's/.*"IP":"\([^"]*\)".*/\1/p')
            if grep -q '^Sandbox 1' "$TORRC" 2>/dev/null || [ ! -f "$NO_SANDBOX" ]; then
                set_status ready "connected; websites see $ip"
            else
                set_status ready "connected; websites see $ip (Tor is running without its sandbox here)"
            fi
            return 0
            ;;
        esac
        skew=$(tor_clock_skew)
        if [ -n "$skew" ] && [ "$skew" != "$fixed" ]; then
            if [ $fixes -lt 3 ] && set_clock_from_tor "$skew"; then
                fixed=$skew
                fixes=$((fixes + 1))
                set_status starting "the clock was wrong; set it from the Tor network, reconnecting"
                systemctl restart tor@default 2>/dev/null || systemctl restart tor 2>/dev/null
                continue
            fi
            set_status starting "the clock is wrong, so Tor can't connect: set the date and time, then switch Tor off and on"
            continue
        fi
        # Tor stopped because of its sandbox: this Tor or this machine
        # can't run it, so it starts again without. Never left blocked for
        # want of a hardening option, but only the sandbox's own failure
        # turns it off.
        if [ $i -ge 5 ] && grep -q '^Sandbox 1' "$TORRC" 2>/dev/null && tor_died && tor_sandbox_failed; then
            mkdir -p "${NO_SANDBOX%/*}"
            tor_version >"$NO_SANDBOX"
            sed -i '/^Sandbox 1$/d' "$TORRC"
            set_status starting "starting Tor again without its sandbox"
            systemctl restart tor@default 2>/dev/null || systemctl restart tor 2>/dev/null
            continue
        fi
        progress=$(tor_progress)
        if [ -n "$progress" ]; then
            set_status starting "connecting to the Tor network: $progress"
        fi
    done
    progress=$(tor_progress)
    set_status error "can't reach the Tor network${progress:+ (stopped at $progress)}; try Pluggable Transports"
}

tor_on() { # tor_on <use bridges: 0|1>
    # Remembered before anything else, so that whatever fails below, the
    # next start (and any firewall reload) still blocks instead of leaking.
    mkdir -p "${REMEMBER%/*}"
    echo "bridges=$1" >"$REMEMBER"
    set_status starting "connecting to the Tor network"
    # Lock down first: from here on nothing goes around Tor.
    if ! lock_down; then
        set_status error "internet blocked: couldn't route through Tor (switch Tor off to reconnect)"
        exit 1
    fi
    if ! command -v tor >/dev/null 2>&1; then
        set_status error "internet blocked: Tor isn't installed (switch Tor off, then: sudo apt install tor)"
        exit 1
    fi
    write_torrc "$1"
    if [ "$1" = 1 ] && [ -z "$(bridge_lines)" ]; then
        set_status error "internet blocked: no bridges to use (FerroOS's built-in list is missing; switch Tor off)"
        exit 1
    fi
    if ! tor --verify-config -f "$TORRC" >/dev/null 2>&1; then
        # Never fall back to connecting to Tor directly: bridges were asked
        # for so the network can't see Tor being used. Stay blocked.
        set_status error "internet blocked: Tor won't accept these bridge lines (check them, or switch Tor off)"
        exit 1
    fi
    resolver_on
    systemctl --no-block restart tor
    start_checker
}

tor_off() {
    stop_checker
    rm -f "$REMEMBER"
    nmcli networking on >/dev/null 2>&1
    systemctl --no-block stop tor tor@default 2>/dev/null
    resolver_off
    firewall_off
    set_status off ""
}

case "${1:-}" in
on)
    bridges=0
    [ "${2:-}" = bridges ] && bridges=1
    tor_on $bridges
    ;;
off)
    tor_off
    ;;
restore)
    if [ -f "$REMEMBER" ]; then
        if grep -q 'bridges=1' "$REMEMBER"; then tor_on 1; else tor_on 0; fi
    else
        set_status off ""
    fi
    ;;
reapply)
    # The firewall service was (re)started, which clears every rule: put the
    # Tor rules straight back if Tor is on.
    [ -f "$REMEMBER" ] && lock_down
    exit 0
    ;;
check)
    check
    ;;
status)
    cat "$STATUS" 2>/dev/null || echo "state=off"
    nft list table inet ferro_tor >/dev/null 2>&1 && echo "firewall=on" || echo "firewall=off"
    ;;
*)
    echo "usage: ferro-tor on [bridges] | off | restore | status" >&2
    exit 2
    ;;
esac
