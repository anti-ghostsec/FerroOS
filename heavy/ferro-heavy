#!/bin/sh
# ferro-heavy: adding to FerroOS Heavy. It ships with almost nothing; this
# is how the rest gets on: drivers, Steam, CUDA, any Debian package, and
# updates for all of it. Everything comes from Debian's archive over HTTPS
# with its signatures checked, and updates like the rest of the system.
#
# "Add Programs" on the Start menu runs `ferro-heavy menu`.

usage() {
    cat <<'EOF'
ferro-heavy menu            choose from a list
ferro-heavy status          what's on, what's off
ferro-heavy update          update everything that's installed
ferro-heavy install <name>  install a Debian package
ferro-heavy drivers         Mesa 3D, Vulkan and video acceleration for
                            Intel and AMD graphics
ferro-heavy nvidia          NVIDIA's graphics driver (with CUDA support for
                            PyTorch and the like)
ferro-heavy enroll-key      let Secure Boot load that driver (asks for a
                            one-time password; you type it again after restart)
ferro-heavy steam           Steam and Proton Vulkan drivers (shows Valve's licence first)
ferro-heavy llm             Python 3, venv & build tools for PyTorch / LLM training
ferro-heavy cuda            NVIDIA's CUDA toolkit: compilers and headers,
                            several GB. PyTorch and most LLM tools bring
                            their own and don't need it.
ferro-heavy audio           unmute sound cards & configure desktop audio (ALSA / PipeWire)
ferro-heavy librewolf       install LibreWolf privacy web browser
EOF
}

# Everything but `status` changes the system.
as_root() {
    [ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
}

yn() { [ "$1" = 0 ] && echo yes || echo no; }

has_nvidia_card() {
    lspci 2>/dev/null | grep -Ei 'vga|3d|display' | grep -qi nvidia
}

secure_boot_on() {
    mokutil --sb-state 2>/dev/null | grep -q enabled
}

case "$1" in
status)
    secure_boot_on; echo "Secure Boot: $(yn $?)"
    echo "Kernel lockdown: $(cat /sys/kernel/security/lockdown 2>/dev/null || echo unknown)"
    lsblk -o TYPE 2>/dev/null | grep -q crypt; echo "Disk encryption (LUKS): $(yn $?)"
    systemctl is-active --quiet nftables; echo "Firewall: $(yn $?)"
    resolvectl status 2>/dev/null | grep -q '+DNSOverTLS'; echo "Encrypted DNS: $(yn $?)"
    systemctl is-active --quiet apparmor; echo "AppArmor: $(yn $?)"
    timedatectl show -p NTPSynchronized 2>/dev/null | grep -q yes; echo "Clock set from the network: $(yn $?)"
    if command -v free >/dev/null 2>&1; then
        echo "Memory in use: $(free -m | awk '/Mem:/ { print $3 " MB used of " $2 " MB" }')"
    fi
    if command -v ip >/dev/null 2>&1; then
        lan_ifaces=$(ip -o link show 2>/dev/null | awk -F': ' '$2 ~ /^(en|eth)/ && $3 ~ /UP/ { print $2 }')
        if [ -n "$lan_ifaces" ]; then
            echo "Ethernet (LAN): connected ($lan_ifaces)"
        else
            echo "Ethernet (LAN): idle or disconnected"
        fi
    fi
    if command -v nmcli >/dev/null 2>&1; then
        wifi_state=$(nmcli -t -f WIFI general 2>/dev/null || echo "unknown")
        echo "Wi-Fi radio: $wifi_state"
    fi
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null ||
            echo "NVIDIA driver: installed but not loaded (after a new install: ferro-heavy enroll-key, then restart)"
        if [ -f /usr/lib/x86_64-linux-gnu/libcuda.so.1 ]; then
            echo "CUDA: runtime library loaded (ready for LLM training & inference)"
        fi
    elif lspci 2>/dev/null | grep -Ei 'vga|3d|display' | grep -qi amd; then
        echo "Graphics: AMD Radeon (in-kernel amdgpu)"
    elif lspci 2>/dev/null | grep -Ei 'vga|3d|display' | grep -qi intel; then
        echo "Graphics: Intel Graphics (in-kernel i915/xe)"
    else
        echo "Graphics: Standard display driver"
    fi
    if [ -d /proc/asound ]; then
        cards=$(cat /proc/asound/cards 2>/dev/null | grep -E '^\s*[0-9]' | head -n2)
        if [ -n "$cards" ]; then
            echo "Sound: hardware detected"
        else
            echo "Sound: no sound cards detected"
        fi
    fi
    ;;
update)
    as_root "$@"
    apt-get update && apt-get full-upgrade
    ;;
install)
    as_root "$@"
    shift
    [ $# -gt 0 ] || { echo "Which package? For example: ferro-heavy install vlc"; exit 1; }
    apt-get update && apt-get install "$@"
    ;;
drivers)
    as_root "$@"
    echo "Installing Mesa 3D, Vulkan and hardware video decoding for Intel and AMD..."
    apt-get update && apt-get install mesa-vulkan-drivers libgl1-mesa-dri mesa-va-drivers
    ;;
nvidia)
    as_root "$@"
    has_nvidia_card || echo "No NVIDIA card was found in this machine; installing anyway."
    # The driver is built here (dkms) for the newest kernel, so the system is
    # brought up to date first: an older running kernel would be left
    # without it. It's signed with a key made on this machine; libcuda1 is
    # what CUDA programs load.
    apt-get update && apt-get full-upgrade || exit 1
    apt-get install dkms linux-headers-amd64 nvidia-driver libcuda1 nvidia-smi firmware-misc-nonfree || exit 1
    if secure_boot_on; then
        echo
        echo "Secure Boot is on, so one more step before the driver can load:"
        "$0" enroll-key
    else
        echo "Restart to start using the driver."
    fi
    ;;
enroll-key)
    as_root "$@"
    KEY=/var/lib/dkms/mok.pub
    [ -f "$KEY" ] || { echo "No driver-signing key yet: it's made when a driver is first built (ferro-heavy nvidia)."; exit 1; }
    if mokutil --test-key "$KEY" 2>/dev/null | grep -q "already enrolled"; then
        echo "The key is already approved."
        exit 0
    fi
    echo "Choose a one-time password. After you restart, a blue screen asks for it:"
    echo "Enroll MOK > Continue > Yes > that password > Reboot."
    mokutil --import "$KEY"
    ;;
steam)
    as_root "$@"
    # Debian's Steam package needs 32-bit libraries beside the 64-bit ones,
    # and Vulkan drivers for Proton to run Windows games.
    dpkg --add-architecture i386 && apt-get update || exit 1
    apt-get install -y --install-recommends libvulkan1 libvulkan1:i386 mesa-vulkan-drivers mesa-vulkan-drivers:i386 libgl1-mesa-dri libgl1-mesa-dri:i386 || exit 1
    if command -v nvidia-smi >/dev/null 2>&1; then
        apt-get install -y nvidia-driver-libs:i386 2>/dev/null || true
    fi
    # Not answered for you: apt shows Valve's licence and asks.
    apt-get install --install-recommends steam || apt-get install --install-recommends steam-installer || exit 1
    ;;
llm)
    as_root "$@"
    echo "Installing Python 3, venv, and build tools for LLM development & training..."
    apt-get update && apt-get install -y python3 python3-pip python3-venv build-essential git || exit 1
    echo
    echo "=== LLM Environment Ready ==="
    if command -v nvidia-smi >/dev/null 2>&1; then
        echo "NVIDIA GPU detected. Recommended PyTorch CUDA setup:"
        echo "  python3 -m venv ~/llm-env"
        echo "  source ~/llm-env/bin/activate"
        echo "  pip install torch torchvision --index-url https://download.pytorch.org/whl/cu121"
    else
        echo "No NVIDIA GPU driver active. For CPU / Vulkan inference (llama.cpp):"
        echo "  python3 -m venv ~/llm-env"
        echo "  source ~/llm-env/bin/activate"
        echo "  pip install llama-cpp-python"
        echo "(To use NVIDIA CUDA: run 'ferro-heavy nvidia' first)"
    fi
    ;;
cuda)
    as_root "$@"
    apt-get update && apt-get install nvidia-cuda-toolkit
    ;;
audio)
    as_root "$@"
    echo "=== Sound Configuration ==="
    if command -v amixer >/dev/null 2>&1; then
        echo "Unmuting ALSA audio outputs..."
        amixer sset Master unmute 2>/dev/null || amixer set Master 80% unmute 2>/dev/null || true
        amixer sset Speaker unmute 2>/dev/null || true
        amixer sset Headphone unmute 2>/dev/null || true
    fi
    echo "ALSA is active (0 MB background memory)."
    printf 'Do you want to install PipeWire for advanced desktop sound? [y/N]: '
    read -r ans
    case "$ans" in
        [yY]*) apt-get update && apt-get install -y pipewire pipewire-pulse wireplumber ;;
        *) echo "Using lightweight ALSA sound." ;;
    esac
    ;;
librewolf)
    as_root "$@"
    echo "Installing LibreWolf privacy browser..."
    mkdir -p /etc/apt/keyrings
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL https://deb.librewolf.net/keyring.gpg > /etc/apt/keyrings/librewolf.gpg
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- https://deb.librewolf.net/keyring.gpg > /etc/apt/keyrings/librewolf.gpg
    fi
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/librewolf.gpg] http://deb.librewolf.net bookworm main" > /etc/apt/sources.list.d/librewolf.list
    apt-get update && apt-get install -y librewolf
    ;;
menu)
    while :; do
        cat <<'EOF'

 Add Programs

   1  Update everything
   2  NVIDIA graphics driver (and CUDA support)
   3  3D graphics and Vulkan (Intel & AMD)
   4  Steam (and Proton Vulkan drivers)
   5  LLM / AI training tools (Python 3, venv, PyTorch setup)
   6  NVIDIA CUDA toolkit (compilers/headers, several GB)
   7  Audio & sound setup (ALSA / PipeWire)
   8  LibreWolf privacy web browser
   9  Install a Debian package by name
  10  Show what's on and off (and memory usage)
   0  Close

EOF
        printf ' Choose: '
        read -r choice || exit 0
        case "$choice" in
        1) "$0" update ;;
        2) "$0" nvidia ;;
        3) "$0" drivers ;;
        4) "$0" steam ;;
        5) "$0" llm ;;
        6) "$0" cuda ;;
        7) "$0" audio ;;
        8) "$0" librewolf ;;
        9)
            printf ' Package name: '
            read -r name
            [ -n "$name" ] && "$0" install "$name"
            ;;
        10) "$0" status ;;
        0 | q | Q) exit 0 ;;
        esac
    done
    ;;
*)
    usage
    ;;
esac
