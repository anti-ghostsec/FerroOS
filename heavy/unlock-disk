#!/bin/sh
# unlock-disk: asks for the disk's passphrase when FerroOS Heavy starts.
#
# The installer names this as the keyscript for the system disk in
# /etc/crypttab when a duress PIN was chosen, and it runs inside the
# initramfs, before anything is unlocked. The passphrase goes to cryptsetup
# as usual. The duress PIN instead destroys the disk's keys, so nothing on
# it can ever be decrypted again, and switches the machine off.
#
# The same PIN at the logon and lock screens does the same (check-password).
# /etc/ferro/duress.hash holds "argon2id <time> <memory> <salt> <hash>"; the
# initramfs hook (initramfs-duress) copies it in, with argon2 and dd.

HASH=/etc/ferro/duress.hash

# erase <device>: the LUKS keyslots (cryptsetup's own erase), then the
# whole header area for good measure; then off, at once.
erase() {
    cryptsetup -q erase "$1" >/dev/null 2>&1
    dd if=/dev/zero of="$1" bs=1M count=16 conv=fsync >/dev/null 2>&1
    sync
    echo o >/proc/sysrq-trigger
    while :; do sleep 60; done
}

is_duress() {
    [ -r "$HASH" ] || return 1
    read -r kind t m salt want <"$HASH"
    case "$kind" in
    argon2id)
        got=$(printf '%s' "$1" | argon2 "$salt" -id -t "$t" -m "$m" -p 1 -l 32 -r 2>/dev/null)
        ;;
    *)
        want=$kind
        got=$(printf '%s' "$1" | sha256sum)
        got=${got%% *}
        ;;
    esac
    [ -n "$got" ] && [ "$got" = "$want" ]
}

pass=$(/lib/cryptsetup/askpass "Please unlock disk ${CRYPTTAB_NAME:-ferro-system}: ")

if [ -n "$pass" ] && [ -n "$CRYPTTAB_SOURCE" ] && is_duress "$pass"; then
    erase "$CRYPTTAB_SOURCE"
fi

printf '%s' "$pass"
