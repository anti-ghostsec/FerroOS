#!/bin/sh
# initramfs-tools hook (installed as /etc/initramfs-tools/hooks/ferro-duress):
# puts what unlock-disk needs to recognise the duress PIN (its Argon2id
# hash and the argon2 program) into the initramfs. Does nothing on a system
# without one.

PREREQ="cryptroot"
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

. /usr/share/initramfs-tools/hook-functions

[ -r /etc/ferro/duress.hash ] || exit 0
# Only root's own (check-password trusts no other either).
for f in /etc/ferro /etc/ferro/duress.hash; do
    [ "$(stat -c %u "$f")" = 0 ] && [ $((0$(stat -c %a "$f") & 022)) = 0 ] || exit 0
done

mkdir -p "$DESTDIR/etc/ferro"
cp /etc/ferro/duress.hash "$DESTDIR/etc/ferro/duress.hash"
chmod 600 "$DESTDIR/etc/ferro/duress.hash"
copy_exec "$(command -v argon2)" /bin/argon2
copy_exec "$(command -v dd)" /bin/dd
copy_exec "$(command -v sync)" /bin/sync
copy_exec "$(command -v sleep)" /bin/sleep
