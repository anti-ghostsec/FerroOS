#!/bin/bash
# ferro-vm: Launch secondary FerroOS virtual machine

# Ensure libvirtd and network are running
virsh --connect qemu:///system net-start ferro-vpn-net 2>/dev/null || true

# Start VM if stopped
STATE=$(virsh --connect qemu:///system domstate FerroOS 2>/dev/null || echo "shut off")
if [ "$STATE" != "running" ]; then
    virsh --connect qemu:///system start FerroOS
fi

# Open graphical console, and automatically stop VM when window is closed
if command -v virt-viewer >/dev/null 2>&1; then
    virt-viewer -c qemu:///system --wait FerroOS
else
    virt-manager --connect qemu:///system --show-domain-console FerroOS
fi

# Power off VM immediately upon window close to release host RAM
virsh --connect qemu:///system destroy FerroOS 2>/dev/null || true
