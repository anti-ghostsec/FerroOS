<?xml version="1.0" encoding="UTF-8"?>
<!-- FerroOS Heavy: the Windows 95 look (Chicago95) for every new account. -->
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Chicago95"/>
    <property name="IconThemeName" type="string" value="Chicago95"/>
    <property name="SoundThemeName" type="string" value="default"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="CursorThemeName" type="string" value="Chicago95_Cursor_Black"/>
    <property name="FontName" type="string" value="Sans 9"/>
    <property name="DecorationLayout" type="string" value="menu:minimize,maximize,close"/>
  </property>
</channel>
