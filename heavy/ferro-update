    for q in /sys/block/sd[a-z]/queue /sys/block/mmcblk[0-9]/queue; do
        [ -w "$q/scheduler" ] || continue
        echo bfq >"$q/scheduler" 2>/dev/null || true
        if [ "$(cat "$q/rotational")" = 1 ]; then lat=75000; else lat=2000; fi
        echo 1 >"$q/wbt_lat_usec" 2>/dev/null || true
        echo "$lat" >"$q/wbt_lat_usec" 2>/dev/null || true
    done
fi

