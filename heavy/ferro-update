#!/bin/sh
# ferro-update: brings FerroOS's own programs up to the newest release. Debian's
# packages come with `ferro-heavy update` (which runs this too); this is the
# rest: the desktop, the file manager, the viewers, the installer and the
# other FerroOS programs, scripts and settings files in /usr/local.
#
#   ferro-update           install the newest release's FerroOS programs
#   ferro-update FILE      install from a ferroos-heavy-update.tar.gz you have
#
# Each release publishes ferroos-heavy-update.tar.gz: what that release's
# image puts in /usr/local, nothing else. It's fetched over HTTPS from the
# FerroOS releases on GitHub, its checksum is checked, and anything in it
# outside FerroOS's own folders is refused. Files are swapped in one at a
# time, each in a single step, so programs that are running carry on.
# GitHub also keeps a signed record of which build made it:
#   gh attestation verify ferroos-heavy-update.tar.gz --repo anti-ghostsec/FerroOS

set -u
# What it makes is everyone's to read, as in the image (root's own umask is 077).
umask 022

RELEASES=https://github.com/anti-ghostsec/FerroOS/releases/latest/download
BUNDLE=ferroos-heavy-update.tar.gz
# Where a bundle may put things: FerroOS's own folders, nowhere else.
ALLOWED='^(\./)?usr/local/(bin|sbin|share/ferro|share/applications|lib/ferro-heavy)(/|$)'

[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

fail() {
    echo "ferro-update: $*" >&2
    exit 1
}

work=$(mktemp -d /usr/local/.ferro-update.XXXXXX) || fail "no room to work in /usr/local"
trap 'rm -rf "$work"' EXIT INT TERM
# Run again by the copy of itself it just installed (below): the folder
# that copy was unpacked in is this one's to clean up.
if [ -n "${FERRO_UPDATE_OLD_WORK:-}" ]; then
    case "$FERRO_UPDATE_OLD_WORK" in
        /usr/local/.ferro-update.*) trap 'rm -rf "$work" "$FERRO_UPDATE_OLD_WORK"' EXIT INT TERM ;;
    esac
fi
# What this copy of ferro-update is, to tell whether the bundle has a newer one.
self=$(sha256sum "$0" 2>/dev/null | cut -d' ' -f1)

if [ $# -ge 1 ]; then
    cp -- "$1" "$work/$BUNDLE" || fail "can't read $1"
    if [ -f "$1.sha256" ]; then cp -- "$1.sha256" "$work/$BUNDLE.sha256"; fi
else
    echo "Downloading FerroOS's newest programs..."
    for f in "$BUNDLE" "$BUNDLE.sha256"; do
        curl --proto '=https' --tlsv1.2 -fsSL --retry 2 -o "$work/$f" "$RELEASES/$f" ||
            fail "couldn't download $f (no internet, or the newest release has no update bundle)"
    done
fi
if [ -f "$work/$BUNDLE.sha256" ]; then
    want=$(cut -d' ' -f1 "$work/$BUNDLE.sha256")
    have=$(sha256sum "$work/$BUNDLE" | cut -d' ' -f1)
    [ -n "$want" ] && [ "$want" = "$have" ] || fail "the download is damaged (checksum doesn't match); nothing was changed"
elif [ $# -eq 0 ]; then
    fail "no checksum came with it; nothing was changed"
fi

# Nothing outside FerroOS's folders, no links pointing out, no device files.
tar -tzf "$work/$BUNDLE" >"$work/names" 2>/dev/null && tar -tvzf "$work/$BUNDLE" >"$work/list" 2>/dev/null ||
    fail "the bundle can't be read; nothing was changed"
grep -Ev "$ALLOWED" "$work/names" | grep -Evx '\./?' | grep -q . &&
    fail "the bundle has files outside FerroOS's folders; nothing was changed"
grep -Eq '(^|/)\.\.(/|$)' "$work/names" && fail "the bundle has '..' in a name; nothing was changed"
grep -Eq '^[^-dl]' "$work/list" && fail "the bundle has special files in it; nothing was changed"
grep -E '^l' "$work/list" | grep -Eq -- '-> (/|.*\.\.)' && fail "the bundle has links pointing elsewhere; nothing was changed"

mkdir "$work/new" && tar -xzf "$work/$BUNDLE" -C "$work/new" --no-same-owner || fail "the bundle can't be unpacked; nothing was changed"

# A restore point first (System Restore), unless ferro-heavy update just made one.
if command -v ferro-restore >/dev/null 2>&1 && ! find /var/lib/ferro/restore -maxdepth 1 -mmin -30 -name '2*' 2>/dev/null | grep -q .; then
    ferro-restore create "Before FerroOS update" >/dev/null || true
fi
# In place, file by file: each a rename on the same drive, so a program that's
# running (the desktop itself) keeps its old copy until it next starts.
cd "$work/new" || fail "unpacking went wrong"
# The parts held back (Settings > Updates, ferro-update-hold): their files
# stay as they are, or stay away if the part was uninstalled.
components=$work/new/usr/local/share/ferro/components.list
[ -f "$components" ] || components=/usr/local/share/ferro/components.list
held_paths=
if [ -s /etc/ferro/update-hold ] && [ -f "$components" ]; then
    held_paths=$(grep -Ev '^[[:space:]]*(#|$)' "$components" |
        awk -F'|' 'NR == FNR { h[$1]; next } ($1 in h) { print $3 }' /etc/ferro/update-hold - | tr ' ' '\n' | grep -v '^$')
fi
held() { # ./path in the bundle
    [ -n "$held_paths" ] || return 1
    p=${1#./}
    printf '%s\n' "$held_paths" | {
        while read -r h; do
            case "$h" in
            */) case "$p/" in "$h"*) exit 0 ;; esac ;;
            *) [ "$p" = "$h" ] && exit 0 ;;
            esac
        done
        exit 1
    }
}
# Each folder as open as in the bundle: root's umask (077) would make a new
# one root-only, and nobody else could start what's in it.
find . -mindepth 1 -type d | while read -r d; do
    held "$d" && continue
    mkdir -p "/$d" && chmod "$(stat -c %a "$d")" "/$d"
done
find . \( -type f -o -type l \) | while read -r f; do
    held "$f" && continue
    dest="/${f#./}"
    tmp="$(dirname "$dest")/.ferro-update.$$.$(basename "$dest")"
    cp -a -- "$f" "$tmp" && chown -h root:root "$tmp" && mv -f -- "$tmp" "$dest" || {
        rm -f -- "$tmp"
        echo "ferro-update: couldn't update $dest" >&2
    }
done
count=$(find . \( -type f -o -type l \) | wc -l)
echo "Updated $count FerroOS files."
# The steps below are this release's. If the bundle brought a newer
# ferro-update, it's the one that knows the newest steps: it runs them,
# once (it installs the same files again first, which changes nothing).
if [ -z "${FERRO_UPDATE_OLD_WORK:-}" ] && [ -f /usr/local/bin/ferro-update ] &&
    [ "$(sha256sum /usr/local/bin/ferro-update | cut -d' ' -f1)" != "$self" ]; then
    cd / && FERRO_UPDATE_OLD_WORK="$work" exec /usr/local/bin/ferro-update "$work/$BUNDLE"
fi

# Debian packages: the ones this release has (packages.list) and the ones it
# dropped (packages-removed.list), from the bundle. Each is added or removed
# once: the record in /var/lib/ferro says which have been, so a package
# someone uninstalled isn't put back, and one installed again by hand stays.
# One that can't be added now (no internet, apt busy) is tried next time.
LISTS=/usr/local/share/ferro
STATE=/var/lib/ferro
APT="apt-get -y -q -o DPkg::Lock::Timeout=300"
installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'ok installed'
}
record() { # state file, package
    { cat "$STATE/$1" 2>/dev/null; echo "$2"; } | sort -u >"$STATE/$1.new" && mv -f "$STATE/$1.new" "$STATE/$1"
}
if [ -f "$LISTS/packages.list" ]; then
    mkdir -p -m 755 "$STATE"
    touch "$STATE/packages-added" "$STATE/packages-removed"
    missing=
    for pkg in $(grep -v '^ *$' "$LISTS/packages.list" | sort -u | comm -23 - "$STATE/packages-added"); do
        if installed "$pkg"; then record packages-added "$pkg"; else missing="$missing $pkg"; fi
    done
    if [ -n "$missing" ]; then
        echo "Adding what this release comes with:$missing..."
        $APT update >/dev/null 2>&1
        # All at once; if one of them can't be had, the rest one by one.
        # shellcheck disable=SC2086
        $APT install --no-install-recommends $missing >/dev/null 2>&1 || for pkg in $missing; do
            $APT install --no-install-recommends "$pkg" >/dev/null 2>&1 || echo "  ($pkg couldn't be added now; the next update tries again)"
        done
        for pkg in $missing; do
            if installed "$pkg"; then record packages-added "$pkg"; fi
        done
    fi
    if [ -f "$LISTS/packages-removed.list" ]; then
        for pkg in $(grep -v '^ *$' "$LISTS/packages-removed.list" | sort -u | comm -23 - "$STATE/packages-removed"); do
            if installed "$pkg"; then
                # Only the package itself: if anything else would go with it,
                # it stays.
                if [ "$(apt-get -s remove "$pkg" 2>/dev/null | grep -c '^Remv')" = 1 ]; then
                    echo "Removing $pkg (FerroOS no longer comes with it)..."
                    $APT remove "$pkg" >/dev/null 2>&1 || { echo "  ($pkg couldn't be removed now; the next update tries again)"; continue; }
                else
                    echo "Keeping $pkg: other programs need it."
                fi
            fi
            record packages-removed "$pkg"
        done
    fi
fi

# Wisp, FerroOS's own browser, took LibreWolf's place (v1.0.42): its
# shortcut, the default for web links and pages, and what's left of
# LibreWolf's setup. People's LibreWolf profiles (~/.librewolf: bookmarks,
# passwords) stay; Wisp imports their exported bookmarks and passwords.
if ! installed librewolf; then
    rm -f /etc/apt/sources.list.d/librewolf.sources /etc/apt/sources.list.d/librewolf.list /etc/apt/keyrings/librewolf.asc
    rm -rf /etc/skel/.librewolf
    rm -f /etc/skel/Desktop/LibreWolf.desktop
fi
if [ -f /usr/local/share/applications/wisp.desktop ]; then
    if [ -d /etc/skel/Desktop ] && [ ! -e /etc/skel/Desktop/Wisp.desktop ]; then
        install -m 755 /usr/local/share/applications/wisp.desktop /etc/skel/Desktop/Wisp.desktop
    fi
    for f in /etc/xdg/mimeapps.list /etc/skel/.config/mimeapps.list; do
        [ -f "$f" ] && sed -i 's/=librewolf\.desktop/=wisp.desktop/' "$f"
    done
    [ -f /etc/profile.d/60-ferro-browser.sh ] && sed -i 's/^export BROWSER=librewolf$/export BROWSER=wisp/' /etc/profile.d/60-ferro-browser.sh
    # Each person's own: their desktop shortcut, default browser, file
    # associations and taskbar pins (sed -i keeps each file its owner's).
    getent passwd | while IFS=: read -r name _ uid gid _ home _; do
        [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
        if [ -f "$home/Desktop/LibreWolf.desktop" ] && ! installed librewolf; then
            rm -f "$home/Desktop/LibreWolf.desktop"
            [ -e "$home/Desktop/Wisp.desktop" ] ||
                install -m 755 -o "$uid" -g "$gid" /usr/local/share/applications/wisp.desktop "$home/Desktop/Wisp.desktop"
        fi
        f="$home/.config/mimeapps.list"
        [ -f "$f" ] && sed -i 's/=librewolf\.desktop/=wisp.desktop/' "$f"
        f="$home/.config/ferro/associations.conf"
        [ -f "$f" ] && sed -i 's/librewolf %f/wisp %f/g' "$f"
        f="$home/.config/ferro/pinned.conf"
        [ -f "$f" ] && sed -i 's/librewolf/wisp/g; s/LibreWolf/Wisp/g' "$f"
    done
fi

# Wisp, the web browser, from its own newest build (after the packages, so
# the libraries a newer Wisp needs are there first). New builds are signed,
# and the updater won't take one it can't check: minisign came later.
if [ -x /usr/local/bin/ferro-wisp-update ] && ! command -v minisign >/dev/null 2>&1; then
    echo "Adding minisign (checks Wisp's updates are genuine)..."
    apt-get install -y -q --no-install-recommends minisign >/dev/null 2>&1 || echo "  (it couldn't be added: sudo apt install minisign)"
fi
if [ -x /usr/local/bin/ferro-wisp-update ]; then
    /usr/local/bin/ferro-wisp-update || true
fi

# The VPN's kill switch came later: started again with the VPN after a
# restart (before the network), and put back when the firewall reloads.
if [ -x /usr/local/sbin/ferro-vpn ] && ! grep -q 'systemd-resolved' /etc/systemd/system/ferro-vpn.service 2>/dev/null; then
    cat >/etc/systemd/system/ferro-vpn.service <<'EOF'
[Unit]
Description=FerroOS Heavy's VPN switch and kill switch
After=nftables.service ferro-tor.service systemd-resolved.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ferro-vpn restore

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 /etc/systemd/system/ferro-vpn.service
    mkdir -p -m 755 /etc/systemd/system/nftables.service.d
    printf '[Service]\nExecStartPost=-/usr/local/sbin/ferro-vpn reapply\nExecReload=-/usr/local/sbin/ferro-vpn reapply\nExecStopPost=-/usr/local/sbin/ferro-vpn reapply\n' \
        >/etc/systemd/system/nftables.service.d/61-ferro-vpn.conf
    chmod 644 /etc/systemd/system/nftables.service.d/61-ferro-vpn.conf
    systemctl daemon-reload 2>/dev/null
    systemctl enable ferro-vpn.service >/dev/null 2>&1 || true
fi
# A VPN that's on now gets its kill switch at once (it remembers its
# server for the next restart), and its own DNS.
if [ -x /usr/local/sbin/ferro-vpn ] && ip link show dev wg0 >/dev/null 2>&1 &&
    { ! nft list table inet ferro_vpn >/dev/null 2>&1 ||
        { [ ! -f /run/systemd/resolved.conf.d/60-ferro-the-vpn.conf ] && grep -qiE '^[[:space:]]*DNS[[:space:]]*=' /etc/wireguard/wg0.conf; }; }; then
    /usr/local/sbin/ferro-vpn on >/dev/null 2>&1 && echo "VPN: kill switch on (if the VPN drops, nothing goes out around it)."
fi

# What the newest releases no longer include.
# The Recycle Bin sound: too sharp.
rm -f /usr/local/share/ferro/sounds/empty.wav
# xterm: LXTerminal is the terminal; mpv's own Start menu entry is hidden
# (the shortcut file comes with this update).
if dpkg-query -W -f='${Status}' xterm 2>/dev/null | grep -q installed &&
    [ "$(apt-get -s remove xterm 2>/dev/null | grep -c '^Remv')" = 1 ]; then
    echo "Removing xterm (LXTerminal is the terminal)..."
    apt-get remove -y -q xterm >/dev/null 2>&1 || echo "  (it couldn't be removed: sudo apt remove xterm)"
fi
rm -f /usr/local/share/applications/debian-xterm.desktop /usr/local/share/applications/debian-uxterm.desktop
# Notifications came in after the first releases: dunst shows them, in
# Windows' style (its settings come with this update).
if ! dpkg-query -W -f='${Status}' dunst 2>/dev/null | grep -q installed; then
    echo "Adding notifications (dunst)..."
    apt-get install -y -q dunst libnotify-bin >/dev/null 2>&1 || echo "  (they couldn't be added: sudo apt install dunst libnotify-bin)"
fi
if [ -f /usr/local/share/ferro/dunst-ferro.conf ]; then
    mkdir -m 755 -p /etc/xdg/dunst/dunstrc.d
    install -m 644 /usr/local/share/ferro/dunst-ferro.conf /etc/xdg/dunst/dunstrc.d/50-ferro.conf
fi
# The VPN needs WireGuard's tools (wg-quick), which the first images
# didn't have: without them it couldn't connect at all.
if ! command -v wg-quick >/dev/null 2>&1; then
    echo "Adding the VPN's tools (wireguard-tools)..."
    apt-get install -y -q --no-install-recommends wireguard-tools >/dev/null 2>&1 || echo "  (they couldn't be added: sudo apt install wireguard-tools)"
fi
# ffmpeg came with the images after v1.0.39.
if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Adding ffmpeg (video and audio converting)..."
    apt-get install -y -q --no-install-recommends ffmpeg >/dev/null 2>&1 || echo "  (it couldn't be added: sudo apt install ffmpeg)"
fi
# Encrypted extra drives came later: one this PC keeps a key for opens by
# itself when plugged in, without a password (only ferro-drive's `open`; see
# harden.sh). Checked by visudo before it's put in place.
if [ -x /usr/local/sbin/ferro-drive ] && [ ! -f /etc/sudoers.d/60-ferro-drives ]; then
    echo '%sudo ALL=(root) NOPASSWD: /usr/local/sbin/ferro-drive open *' >/etc/sudoers.d/.60-ferro-drives
    chmod 0440 /etc/sudoers.d/.60-ferro-drives
    if visudo -cqf /etc/sudoers.d/.60-ferro-drives; then
        mv /etc/sudoers.d/.60-ferro-drives /etc/sudoers.d/60-ferro-drives
    else
        rm -f /etc/sudoers.d/.60-ferro-drives
    fi
fi
mkdir -p -m 755 /Drives
# The bundle is the image's /usr/local, Setup's Start menu entry with it: on
# a computer FerroOS is installed on (not started from the USB stick) it goes.
[ -d /run/live/medium ] || rm -f /usr/local/share/applications/ferro-install.desktop
if dpkg-query -W -f='${Status}' viewnior 2>/dev/null | grep -q installed; then
    echo "Removing Viewnior (pictures open in FerroOS's Image Viewer now)..."
    apt-get remove -y -q viewnior >/dev/null 2>&1 || echo "  (it couldn't be removed: sudo apt remove viewnior)"
fi
mkdir -p /Programs /var/lib/ferro/programs /usr/local/lib/ferro-programs
# Readable by everyone (root's umask makes them root-only), and what was
# installed into them before.
chmod 711 /var/lib/ferro
chmod 755 /Programs /var/lib/ferro/programs /usr/local/lib/ferro-programs
find /Programs -mindepth 1 -maxdepth 1 -exec chmod -R go-w,a+rX {} +
find /var/lib/ferro/programs /usr/local/lib/ferro-programs -type f -exec chmod a+r {} +
# Launchers from before programs got a writable layer over their folder (see
# ferro-installer): remade, so programs that save beside themselves start.
for record in /var/lib/ferro/programs/*.conf; do
    [ -f "$record" ] && grep -qx 'kind=folder' "$record" || continue
    id=$(basename "$record" .conf)
    name=$(sed -n 's/^name=//p' "$record")
    dir=$(sed -n 's/^dir=//p' "$record")
    launcher=$(sed -n 's/^launcher=//p' "$record")
    [ -f "$launcher" ] && ! grep -q '^layer=' "$launcher" || continue
    exe=$(sed -n "s/^cd '[^']*' && exec '\([^']*\)' \"\$@\"\$/\1/p" "$launcher")
    [ -n "$exe" ] && [ -n "$dir" ] || continue
    /usr/local/bin/ferro-installer --launcher "$id" "$name" "$dir" "$exe" >"$launcher.new" &&
        chmod 755 "$launcher.new" && mv -f "$launcher.new" "$launcher" && echo "Updated the launcher of $name."
done
# Older sessions started udiskie (45 MB of Python) to mount USB sticks:
# ferro-automount does it in a fraction of that. ferro-inhibit too, which
# had nothing to do (screen blanking is off).
X=/etc/X11/xinit/xinitrc
if [ -f "$X" ] && grep -q 'udiskie -N -T' "$X"; then
    cp "$X" "$X.bak-before-automount"
    sed -i -e 's/command -v udiskie /command -v ferro-automount /' -e '/udiskie-mount -a/d' -e 's/udiskie -N -T &/ferro-automount \&/' "$X"
    echo "The session mounts drives with ferro-automount now (from the next log on)."
fi
# Older sessions let GTK programs keep thumbnails of pictures on the disk:
# in memory from now on, and those already made are gone.
if [ -f "$X" ] && ! grep -q 'XDG_RUNTIME_DIR/thumbnails' "$X"; then
    cp "$X" "$X.bak-before-thumbnails"
    sed -i '/^# USB sticks and SD cards appear/i\
if [ -n "$XDG_RUNTIME_DIR" ] \&\& [ -d "$XDG_RUNTIME_DIR" ]; then\
    rm -rf "$HOME/.cache/thumbnails" "$XDG_RUNTIME_DIR/thumbnails"\
    mkdir -p -m 700 "$HOME/.cache" "$XDG_RUNTIME_DIR/thumbnails"\
    ln -s "$XDG_RUNTIME_DIR/thumbnails" "$HOME/.cache/thumbnails"\
fi' "$X"
    rm -rf /home/*/.cache/thumbnails /root/.cache/thumbnails
    echo "Thumbnails other programs make are kept in memory now, not on the disk (from the next log on)."
fi
# Older sessions left the sound on the first sound card found, often a
# graphics card's HDMI with nothing plugged into it: ferro-audio picks.
if [ -f "$X" ] && ! grep -q 'ferro-audio apply' "$X"; then
    cp "$X" "$X.bak-before-audio"
    sed -i '/^# Smooth drawing (picom/i\
# Sound out of the speakers that are plugged in (or those chosen in Volume\
# Control), not the first sound card found.\
if [ -x /usr/local/bin/ferro-audio ]; then\
    /usr/local/bin/ferro-audio apply 2>/dev/null || true\
fi' "$X"
    echo "Sound comes out of the speakers that are plugged in now (Volume Control picks others)."
fi
# And for whoever is updating, at once: no need to wait for the log on.
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && [ -x /usr/local/bin/ferro-audio ]; then
    su "$SUDO_USER" -s /bin/sh -c '/usr/local/bin/ferro-audio apply' </dev/null >/dev/null 2>&1 || true
fi
# Ryzen graphics went white or flickered with smooth drawing on (the screen
# read from scattered pages the strict IOMMU doesn't give it): shown from one
# block from the next start (see harden.sh).
G=/etc/default/grub.d/60-ferro-heavy.cfg
if [ -f "$G" ] && ! grep -q 'amdgpu.sg_display=0' "$G"; then
    cp "$G" "$G.bak-before-sg-display"
    sed -i 's/ i915.enable_psr=0/ amdgpu.sg_display=0 i915.enable_psr=0/' "$G"
    if grep -q 'amdgpu.sg_display=0' "$G" && command -v update-grub >/dev/null 2>&1 && update-grub >/dev/null 2>&1; then
        echo "Ryzen graphics: no more white screen with smooth drawing (from the next restart)."
    else
        cp "$G.bak-before-sg-display" "$G"
        echo "ferro-update: couldn't change the boot options for Ryzen graphics." >&2
    fi
fi
systemctl disable unattended-upgrades.service >/dev/null 2>&1 || true
# Older installs only switched the microphone and camera off until the next
# restart: the switches as each person last set them, kept from now on.
if [ -x /usr/local/sbin/ferro-switch-hardware ]; then
    /usr/local/sbin/ferro-switch-hardware rules
    for conf in /home/*/.config/ferro/switches.conf; do
        [ -f "$conf" ] || continue
        grep -q '^microphone = false' "$conf" && /usr/local/sbin/ferro-switch-hardware mic off >/dev/null
        grep -q '^camera = false' "$conf" && /usr/local/sbin/ferro-switch-hardware cam off >/dev/null
    done
fi
# Older installs let the sudo group run /bin/kill as root, and the privacy
# switches and the VPN with any arguments, all without a password: the
# rules as harden.sh writes them now (the reasons are there). Each is
# checked by visudo before it replaces the old one.
sudo_rule() { # sudo_rule NAME RULE
    tmp=$(mktemp /etc/sudoers.d/.ferro-update.XXXXXX) || return 1
    printf '%s\n' "$2" >"$tmp" && chmod 0440 "$tmp" && visudo -cqf "$tmp" >/dev/null 2>&1 &&
        mv -f "$tmp" "/etc/sudoers.d/$1" || {
        rm -f "$tmp"
        echo "ferro-update: couldn't update the sudo rule $1" >&2
    }
}
if [ -x /usr/local/sbin/ferro-endtask ] && [ -d /etc/sudoers.d ]; then
    S=/usr/local/sbin/ferro-switch-hardware
    rule="%sudo ALL=(root) NOPASSWD: $S mic on, $S mic off, $S cam on, $S cam off, $S net on, $S net off"
    for mic in on off; do
        for cam in on off; do
            for net in on off; do
                rule="$rule, $S apply-all $mic $cam $net"
            done
        done
    done
    sudo_rule 60-ferro-switches "$rule"
    V=/usr/local/sbin/ferro-vpn
    sudo_rule 60-ferro-vpn "%sudo ALL=(root) NOPASSWD: $V on, $V off, $V status, $V import, $V killswitch on, $V killswitch off"
    E=/usr/local/sbin/ferro-endtask
    sudo_rule 60-ferro-endtask "%sudo ALL=(root) NOPASSWD: $E TERM *, $E KILL *, $E STOP *, $E CONT *"
    sudo_rule 60-ferro-usb-lock "%sudo ALL=(root) NOPASSWD: /usr/local/sbin/ferro-usb-lock lock"
fi
# The desktop's graphics card came later (ferro-gpu, Display Properties'
# Graphics tab).
if [ -x /usr/local/bin/ferro-gpu ] && [ -d /etc/sudoers.d ]; then
    sudo_rule 60-ferro-gpu "%sudo ALL=(root) NOPASSWD: /usr/local/bin/ferro-gpu desktop *, /usr/local/bin/ferro-gpu close"
    # Graphics cards nothing is set to use, closed to programs now (they
    # left Chromium and Electron apps with a white window).
    /usr/local/bin/ferro-gpu close
fi
if [ -x /usr/local/sbin/ferro-portal ] && [ -d /etc/sudoers.d ]; then
    P=/usr/local/sbin/ferro-portal
    sudo_rule 60-ferro-portal "%sudo ALL=(root) NOPASSWD: $P on, $P off, $P status"
fi
# Settings > Updates holds parts back and lets them go again without a
# password (uninstalling one asks for it).
if [ -x /usr/local/sbin/ferro-update-hold ] && [ -d /etc/sudoers.d ]; then
    H=/usr/local/sbin/ferro-update-hold
    sudo_rule 60-ferro-update-hold "%sudo ALL=(root) NOPASSWD: $H hold *, $H release *"
fi
# The default browser only while Wisp is there (it can be uninstalled).
if [ -f /etc/profile.d/60-ferro-browser.sh ] && grep -qx 'export BROWSER=wisp' /etc/profile.d/60-ferro-browser.sh; then
    sed -i 's|^export BROWSER=wisp$|if [ -x /usr/local/bin/wisp ]; then export BROWSER=wisp; fi|' /etc/profile.d/60-ferro-browser.sh
fi
# Restricted folders keep what each folder was here (see harden.sh).
mkdir -p /var/lib/ferro/restricted && chmod 711 /var/lib/ferro/restricted
if [ -x /usr/local/sbin/ferro-usb-lock ] && [ ! -f /etc/udev/rules.d/71-ferro-usb-lock.rules ]; then
    cat >/etc/udev/rules.d/71-ferro-usb-lock.rules <<'EOF'
# FerroOS: no new USB devices while the screen is locked (ferro-usb-lock).
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="usb[0-9]*", TEST=="/run/ferro/usb-locked", ATTR{authorized_default}="0"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL!="usb[0-9]*", TEST=="/run/ferro/usb-locked", ATTR{authorized}="0"
EOF
    chmod 644 /etc/udev/rules.d/71-ferro-usb-lock.rules
    udevadm control --reload 2>/dev/null || true
fi
# Older installs left GTK's settings root-only (programs ignored them), and
# had no NTFS recovery on mount.
[ -f /etc/gtk-3.0/settings.ini ] && chmod 644 /etc/gtk-3.0/settings.ini
# No list of recently opened files, for GTK 3 and 4 alike.
for v in 3.0 4.0; do
    f=/etc/gtk-$v/settings.ini
    # Root's umask would make a new folder root-only: GTK must read it.
    mkdir -p -m 755 /etc/gtk-$v
    chmod 755 /etc/gtk-$v
    [ -f "$f" ] || printf '[Settings]\n' >"$f"
    grep -q '^gtk-recent-files-enabled' "$f" || printf 'gtk-recent-files-enabled = false\ngtk-recent-files-max-age = 0\n' >>"$f"
    chmod 644 "$f"
done
if [ ! -f /etc/udisks2/mount_options.conf ] && [ -d /etc/udisks2 ]; then
    cat >/etc/udisks2/mount_options.conf <<'EOF'
# FerroOS: mount NTFS drives and cards with ntfs-3g first. It recovers a
# volume that was unplugged without ejecting (clears the leftover journal),
# where the ntfs3 kernel driver refuses to mount it at all.
[defaults]
ntfs_drivers=ntfs,ntfs3
ntfs:ntfs_defaults=uid=$UID,gid=$GID,windows_names
ntfs:ntfs_allow=uid=$UID,gid=$GID,umask,dmask,fmask,locale,norecover,ignore_case,windows_names,compression,nocompression,big_writes
ntfs:ntfs3_defaults=uid=$UID,gid=$GID
ntfs:ntfs3_allow=uid=$UID,gid=$GID,umask,dmask,fmask,iocharset,discard,nodiscard,sparse,nosparse,hidden,nohidden,sys_immutable,nosys_immutable,showmeta,noshowmeta,prealloc,noprealloc,hide_dot_files,nohide_dot_files,windows_names,nocase,case
EOF
    chmod 644 /etc/udisks2/mount_options.conf
fi

echo
echo "Done. Log off and on again (Start > Log Off) for the new desktop."
