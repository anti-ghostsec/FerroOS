#!/bin/sh
# ferro-update: brings FerroOS's own programs up to the newest release. Debian's
# packages come with `ferro-heavy update` (which runs this too); this is the
# rest: the desktop, the file manager, the viewers, the installer and the
# other FerroOS programs, scripts and settings files in /usr/local.
#
#   ferro-update               install the newest release's FerroOS programs
#   ferro-update FILE          install from a ferroos-heavy-update.tar.gz you
#                              have (its FILE.minisig beside it)
#   ferro-update --check FILE  only say whether FILE would be installed:
#                              changes nothing, asks for no password
#
# Each release publishes ferroos-heavy-update.tar.gz: what that release's
# image puts in /usr/local, nothing else. It's fetched over HTTPS from the
# FerroOS releases on GitHub. Each is signed (minisign) with FerroOS's
# release key, whose public half is below: only a bundle with a good
# signature, for a release no older than the one installed, goes in. That
# holds for a file you have just the same, and there's no switch to turn it
# off: what goes in runs as root. (A build of your own is tried out with
# tools/heavy/install-here.sh, which doesn't come through here.) Anything
# in a bundle outside FerroOS's own folders is refused. Files are swapped
# in one at a time, each in a single step, so programs that are running
# carry on.
# GitHub also keeps a signed record of which build made it:
#   gh attestation verify ferroos-heavy-update.tar.gz --repo anti-ghostsec/FerroOS

set -u
# What it makes is everyone's to read, as in the image (root's own umask is 077).
umask 022

RELEASES=https://github.com/anti-ghostsec/FerroOS/releases/latest/download
BUNDLE=ferroos-heavy-update.tar.gz
# FerroOS's release signing key (minisign): the line of the public key file
# that starts with RW. The release workflow signs with its secret half (the
# MINISIGN_SECRET_KEY repository secret), and publishes nothing while this
# is still the placeholder.
PUBKEY=RWQEzC0eP9R4JRArq2/Lu6i7CMipnLZxho2hzinHo3WaJzYuFZedq+48
# The release installed, and when the commit of the last update was made
# (from its signature): an update older than either is refused, so an old
# release, holes and all, can't be passed off as the newest.
RELEASE_FILE=/usr/local/share/ferro/release
BUILT_FILE=/var/lib/ferro/update-built
# Where a bundle may put things: FerroOS's own folders, nowhere else.
ALLOWED='^(\./)?usr/local/(bin|sbin|share/ferro|share/applications|lib/ferro-heavy)(/|$)'

fail() {
    echo "ferro-update: $*" >&2
    exit 1
}

check=
if [ "${1:-}" = --check ]; then
    check=1
    shift
    [ $# -ge 1 ] || fail "usage: ferro-update --check FILE"
fi
[ -n "$check" ] || [ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

# Without the key there's no telling a real update from a forged one: then
# none is installed, rather than any.
printf '%s' "$PUBKEY" | grep -Eqx 'RW[A-Za-z0-9+/]{54}' ||
    fail "this ferro-update was built without FerroOS's release key, so it can't tell a real update from a forged one; nothing was changed"

if [ -n "$check" ]; then
    work=$(mktemp -d "${TMPDIR:-/tmp}/ferro-update.XXXXXX") || fail "no room to work in"
else
    work=$(mktemp -d /usr/local/.ferro-update.XXXXXX) || fail "no room to work in /usr/local"
fi
trap 'rm -rf "$work"' EXIT INT TERM
# Run again by the copy of itself it just installed (below): the folder
# that copy was unpacked in is this one's to clean up.
handed=
if [ -z "$check" ] && [ -n "${FERRO_UPDATE_OLD_WORK:-}" ]; then
    case "$FERRO_UPDATE_OLD_WORK" in
        /usr/local/.ferro-update.*)
            handed=1
            trap 'rm -rf "$work" "$FERRO_UPDATE_OLD_WORK"' EXIT INT TERM
            ;;
    esac
fi
# What this copy of ferro-update is, to tell whether the bundle has a newer one.
self=$(sha256sum "$0" 2>/dev/null | cut -d' ' -f1)

get() { # NAME: from the newest release into the work folder
    curl --proto '=https' --tlsv1.2 -fsSL --retry 2 -o "$work/$1" "$RELEASES/$1"
}

# The checksum, where there is one, only tells a damaged download from a
# forged one; the signature is what decides.
sums=
if [ $# -ge 1 ]; then
    cp -- "$1" "$work/$BUNDLE" || fail "can't read $1"
    if [ -f "$1.sha256" ]; then cp -- "$1.sha256" "$work/$BUNDLE.sha256" && sums=1; fi
    if [ -f "$1.minisig" ]; then
        cp -- "$1.minisig" "$work/$BUNDLE.minisig" || fail "can't read $1.minisig"
    elif [ -n "$handed" ]; then
        # Handed over by a ferro-update from before updates were signed: it
        # fetched no signature, and has put the files in already. The newest
        # release's is fetched now, and nothing more is done unless it
        # checks out.
        get "$BUNDLE.minisig" ||
            fail "this update came through an older ferro-update, which couldn't check who made it, and its signature can't be fetched now (no internet?). Run ferro-update again to check it and finish"
    else
        fail "$1 has no signature beside it ($1.minisig, from the same release); nothing was changed"
    fi
else
    echo "Downloading FerroOS's newest programs..."
    get "$BUNDLE" || fail "couldn't download $BUNDLE (no internet, or the newest release has no update bundle)"
    get "$BUNDLE.minisig" || fail "the newest release's update isn't signed; nothing was changed"
    get "$BUNDLE.sha256" 2>/dev/null && sums=1
fi
if [ -n "$sums" ]; then
    want=$(cut -d' ' -f1 "$work/$BUNDLE.sha256")
    have=$(sha256sum "$work/$BUNDLE" | cut -d' ' -f1)
    [ -n "$want" ] && [ "$want" = "$have" ] || fail "the download is damaged (checksum doesn't match); nothing was changed"
fi

# minisign checks the signature. The images come with it; the first ones
# didn't (it's Debian's package, checked by apt).
if ! command -v minisign >/dev/null 2>&1 && [ -z "$check" ]; then
    echo "Adding minisign (checks that updates are genuine)..."
    apt-get install -y -q --no-install-recommends minisign >/dev/null 2>&1
fi
command -v minisign >/dev/null 2>&1 ||
    fail "can't check the update's signature without minisign (sudo apt install minisign); nothing was changed"

is_release() { printf '%s' "$1" | grep -Eqx 'v[0-9]{1,6}(\.[0-9]{1,6}){0,3}'; }
is_time() { printf '%s' "$1" | grep -Eqx '[0-9]{1,12}'; }
# older A B: release A comes before release B (v1.0.9 before v1.0.10).
older() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]; }

# Signed with FerroOS's key. The trusted comment, which the signature
# covers too, is "ferroos RELEASE TIME": which release this is, and when
# its commit was made.
signed() {
    unchanged="nothing was changed"
    # Handed over: the older ferro-update put the files in before this one
    # could look (it made a restore point first).
    [ -z "$handed" ] || unchanged="and the older ferro-update that fetched it has put its files in already. System Restore has a point from before it"
    trusted=$(minisign -V -Q -P "$PUBKEY" -m "$work/$BUNDLE" -x "$work/$BUNDLE.minisig" 2>/dev/null) ||
        fail "the update's signature doesn't check out (it isn't FerroOS's, or it was changed on the way); $unchanged"
    set -f
    # shellcheck disable=SC2086
    set -- $trusted
    set +f
    [ "$#" = 3 ] && [ "$1" = ferroos ] && is_release "$2" && is_time "$3" ||
        fail "the signature is FerroOS's, but not for an update bundle; nothing was changed"
    release=$2
    when=$3
}
signed
had=$(tr -d ' \n' 2>/dev/null <"$RELEASE_FILE")
if is_release "$had" && older "$release" "$had"; then
    fail "that's FerroOS $release, older than the $had installed; nothing was changed"
fi
built=$(tr -d ' \n' 2>/dev/null <"$BUILT_FILE")
if is_time "$built" && [ "$when" -lt "$built" ]; then
    fail "that update was built before the one installed; nothing was changed"
fi

# Nothing outside FerroOS's folders, no links pointing out, no device files.
tar -tzf "$work/$BUNDLE" >"$work/names" 2>/dev/null && tar -tvzf "$work/$BUNDLE" >"$work/list" 2>/dev/null ||
    fail "the bundle can't be read; nothing was changed"
grep -Ev "$ALLOWED" "$work/names" | grep -Evx '\./?' | grep -q . &&
    fail "the bundle has files outside FerroOS's folders; nothing was changed"
grep -Eq '(^|/)\.\.(/|$)' "$work/names" && fail "the bundle has '..' in a name; nothing was changed"
grep -Eq '^[^-dl]' "$work/list" && fail "the bundle has special files in it; nothing was changed"
grep -E '^l' "$work/list" | grep -Eq -- '-> (/|.*\.\.)' && fail "the bundle has links pointing elsewhere; nothing was changed"
# The release it says it is, inside, is the one the signature is for.
inside=$(grep -Ex '(\./)?usr/local/share/ferro/release' "$work/names" | head -n 1)
[ -n "$inside" ] && [ "$(tar -xzOf "$work/$BUNDLE" "$inside" 2>/dev/null | tr -d ' \n')" = "$release" ] ||
    fail "the bundle isn't the release its signature is for; nothing was changed"

if [ -n "$check" ]; then
    echo "FerroOS $release, signed with FerroOS's release key${had:+ (installed: $had)}: ferro-update would install it."
    exit 0
fi

mkdir "$work/new" && tar -xzf "$work/$BUNDLE" -C "$work/new" --no-same-owner || fail "the bundle can't be unpacked; nothing was changed"

# A restore point first (System Restore), unless ferro-heavy update just made one.
if command -v ferro-restore >/dev/null 2>&1 && ! find /var/lib/ferro/restore -maxdepth 1 -mmin -30 -name '2*' 2>/dev/null | grep -q .; then
    ferro-restore create "Before FerroOS update" >/dev/null || true
fi
# In place, file by file: each a rename on the same drive, so a program that's
# running (the desktop itself) keeps its old copy until it next starts.
cd "$work/new" || fail "unpacking went wrong"
# The parts held back (Settings > Updates, ferro-update-hold): their files
# stay as they are, or stay away if the part was uninstalled.
components=$work/new/usr/local/share/ferro/components.list
[ -f "$components" ] || components=/usr/local/share/ferro/components.list
held_paths=
if [ -s /etc/ferro/update-hold ] && [ -f "$components" ]; then
    held_paths=$(grep -Ev '^[[:space:]]*(#|$)' "$components" |
        awk -F'|' 'NR == FNR { h[$1]; next } ($1 in h) { print $3 }' /etc/ferro/update-hold - | tr ' ' '\n' | grep -v '^$')
fi
held() { # ./path in the bundle
    [ -n "$held_paths" ] || return 1
    p=${1#./}
    printf '%s\n' "$held_paths" | {
        while read -r h; do
            case "$h" in
            */) case "$p/" in "$h"*) exit 0 ;; esac ;;
            *) [ "$p" = "$h" ] && exit 0 ;;
            esac
        done
        exit 1
    }
}
# Each folder as open as in the bundle: root's umask (077) would make a new
# one root-only, and nobody else could start what's in it.
find . -mindepth 1 -type d | while read -r d; do
    held "$d" && continue
    mkdir -p "/$d" && chmod "$(stat -c %a "$d")" "/$d"
done
find . \( -type f -o -type l \) | while read -r f; do
    held "$f" && continue
    dest="/${f#./}"
    tmp="$(dirname "$dest")/.ferro-update.$$.$(basename "$dest")"
    cp -a -- "$f" "$tmp" && chown -h root:root "$tmp" && mv -f -- "$tmp" "$dest" || {
        rm -f -- "$tmp"
        echo "ferro-update: couldn't update $dest" >&2
    }
done
count=$(find . \( -type f -o -type l \) | wc -l)
echo "Updated $count FerroOS files."
# When this release's commit was made: nothing older goes in after it.
mkdir -p -m 755 "$(dirname "$BUILT_FILE")" && echo "$when" >"$BUILT_FILE"
# The steps below are this release's. If the bundle brought a newer
# ferro-update, it's the one that knows the newest steps: it runs them,
# once (it installs the same files again first, which changes nothing).
if [ -z "${FERRO_UPDATE_OLD_WORK:-}" ] && [ -f /usr/local/bin/ferro-update ] &&
    [ "$(sha256sum /usr/local/bin/ferro-update | cut -d' ' -f1)" != "$self" ]; then
    cd / && FERRO_UPDATE_OLD_WORK="$work" exec /usr/local/bin/ferro-update "$work/$BUNDLE"
fi

# Nobody is in the input group any more: through it every program a person
# ran could read each key pressed, whatever it was typed into, and press
# keys itself. The display server reads the keyboard, and game controllers
# are the logged-on person's without it. From their next log on.
getent passwd | while IFS=: read -r name _ uid _ _ _ _; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
    id -nG "$name" 2>/dev/null | tr ' ' '\n' | grep -qx input || continue
    gpasswd -d "$name" input >/dev/null 2>&1 &&
        echo "$name is out of the input group (programs could read the keyboard through it); from the next log on."
done

# Debian packages: the ones this release has (packages.list) and the ones it
# dropped (packages-removed.list), from the bundle. Each is added or removed
# once: the record in /var/lib/ferro says which have been, so a package
# someone uninstalled isn't put back, and one installed again by hand stays.
# One that can't be added now (no internet, apt busy) is tried next time.
LISTS=/usr/local/share/ferro
STATE=/var/lib/ferro
APT="apt-get -y -q -o DPkg::Lock::Timeout=300"
installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'ok installed'
}
record() { # state file, package
    { cat "$STATE/$1" 2>/dev/null; echo "$2"; } | sort -u >"$STATE/$1.new" && mv -f "$STATE/$1.new" "$STATE/$1"
}
if [ -f "$LISTS/packages.list" ]; then
    mkdir -p -m 755 "$STATE"
    touch "$STATE/packages-added" "$STATE/packages-removed"
    missing=
    for pkg in $(grep -v '^ *$' "$LISTS/packages.list" | sort -u | comm -23 - "$STATE/packages-added"); do
        if installed "$pkg"; then record packages-added "$pkg"; else missing="$missing $pkg"; fi
    done
    if [ -n "$missing" ]; then
        echo "Adding what this release comes with:$missing..."
        $APT update >/dev/null 2>&1
        # All at once; if one of them can't be had, the rest one by one.
        # shellcheck disable=SC2086
        $APT install --no-install-recommends $missing >/dev/null 2>&1 || for pkg in $missing; do
            $APT install --no-install-recommends "$pkg" >/dev/null 2>&1 || echo "  ($pkg couldn't be added now; the next update tries again)"
        done
        for pkg in $missing; do
            if installed "$pkg"; then record packages-added "$pkg"; fi
        done
    fi
    if [ -f "$LISTS/packages-removed.list" ]; then
        for pkg in $(grep -v '^ *$' "$LISTS/packages-removed.list" | sort -u | comm -23 - "$STATE/packages-removed"); do
            if installed "$pkg"; then
                # Only the package itself: if anything else would go with it,
                # it stays.
                if [ "$(apt-get -s remove "$pkg" 2>/dev/null | grep -c '^Remv')" = 1 ]; then
                    echo "Removing $pkg (FerroOS no longer comes with it)..."
                    $APT remove "$pkg" >/dev/null 2>&1 || { echo "  ($pkg couldn't be removed now; the next update tries again)"; continue; }
                else
                    echo "Keeping $pkg: other programs need it."
                fi
            fi
            record packages-removed "$pkg"
        done
    fi
fi

# as_owner UID GID COMMAND...: COMMAND as the person whose home it works
# in, never as root. Their home is theirs to change while this runs: a
# file checked here can be a link to one of the system's a moment later,
# and root would follow it. As them, it leads only where they could go.
as_owner() {
    u=$1 g=$2
    shift 2
    setpriv --reuid="$u" --regid="$g" --clear-groups --no-new-privs -- "$@"
}

# The desktop used to keep a log of everything it printed in each person's
# home (~/.desktop.log): a record on disk of what they did. It no longer
# does; the old logs go.
getent passwd | while IFS=: read -r _ _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] && [ -f "$home/.desktop.log" ] && [ ! -L "$home/.desktop.log" ] || continue
    as_owner "$uid" "$gid" sh -c 'shred -u -- "$1" 2>/dev/null || rm -f -- "$1"' sh "$home/.desktop.log"
done

# No record on disk of what was installed (apt, dpkg, alternatives), of
# logins, of virtual machines run, or of sites wget downloaded from: from
# now on nothing new is written, and what was kept goes (v1.0.70).
mkdir -p /etc/dpkg/dpkg.cfg.d /etc/apt/apt.conf.d /etc/tmpfiles.d
echo 'log /dev/null' >/etc/dpkg/dpkg.cfg.d/60-ferro-heavy
# apt's logs in memory (gone at each start), not /dev/null: apt sets its
# log files' owner and mode, which mustn't happen to /dev/null.
printf '%s\n' 'd /run/ferro-apt 0750 root adm -' 'D /var/log/libvirt/qemu 0750 root root -' >/etc/tmpfiles.d/60-ferro-heavy-logs.conf
mkdir -p -m 750 /run/ferro-apt
echo 'Dir::Log "/run/ferro-apt";' >/etc/apt/apt.conf.d/60-ferro-heavy-logs
ln -sf /dev/null /var/log/alternatives.log
grep -qs '^hsts *= *off' /etc/wgetrc || printf '\n# FerroOS: no list of sites downloaded from (~/.wget-hsts).\nhsts = off\n' >>/etc/wgetrc
for f in /var/log/apt/history.log* /var/log/apt/term.log* /var/log/apt/eipp.log* /var/log/dpkg.log* /var/log/alternatives.log.*; do
    [ -f "$f" ] && [ ! -L "$f" ] && { shred -u -- "$f" 2>/dev/null || rm -f -- "$f"; }
done
for f in /var/log/wtmp /var/log/btmp /var/log/lastlog; do
    [ -f "$f" ] && [ ! -L "$f" ] && : >"$f"
done
find /var/log/libvirt/qemu -type f -name '*.log*' -delete 2>/dev/null
getent passwd | while IFS=: read -r _ _ uid gid _ home _; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] && [ -f "$home/.wget-hsts" ] && [ ! -L "$home/.wget-hsts" ] || continue
    as_owner "$uid" "$gid" rm -f -- "$home/.wget-hsts"
done

# Wisp, FerroOS's own browser, took LibreWolf's place (v1.0.42): its
# shortcut, the default for web links and pages, and what's left of
# LibreWolf's setup. People's LibreWolf profiles (~/.librewolf: bookmarks,
# passwords) stay; Wisp imports their exported bookmarks and passwords.
if ! installed librewolf; then
    rm -f /etc/apt/sources.list.d/librewolf.sources /etc/apt/sources.list.d/librewolf.list /etc/apt/keyrings/librewolf.asc
    rm -rf /etc/skel/.librewolf
    rm -f /etc/skel/Desktop/LibreWolf.desktop
fi
if [ -f /usr/local/share/applications/wisp.desktop ]; then
    if [ -d /etc/skel/Desktop ] && [ ! -e /etc/skel/Desktop/Wisp.desktop ]; then
        install -m 755 /usr/local/share/applications/wisp.desktop /etc/skel/Desktop/Wisp.desktop
    fi
    for f in /etc/xdg/mimeapps.list /etc/skel/.config/mimeapps.list; do
        [ -f "$f" ] && sed -i 's/=librewolf\.desktop/=wisp.desktop/' "$f"
    done
    [ -f /etc/profile.d/60-ferro-browser.sh ] && sed -i 's/^export BROWSER=librewolf$/export BROWSER=wisp/' /etc/profile.d/60-ferro-browser.sh
    # Each person's own, as them: their desktop shortcut, default browser,
    # file associations and taskbar pins.
    lw_gone=$(installed librewolf || echo 1)
    getent passwd | while IFS=: read -r name _ uid gid _ home _; do
        [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
        as_owner "$uid" "$gid" sh -c '
            home=$1
            if [ -f "$home/Desktop/LibreWolf.desktop" ] && [ -n "$2" ]; then
                rm -f "$home/Desktop/LibreWolf.desktop"
                [ -e "$home/Desktop/Wisp.desktop" ] ||
                    install -m 755 /usr/local/share/applications/wisp.desktop "$home/Desktop/Wisp.desktop"
            fi
            f="$home/.config/mimeapps.list"
            [ -f "$f" ] && sed -i "s/=librewolf\\.desktop/=wisp.desktop/" "$f"
            f="$home/.config/ferro/associations.conf"
            [ -f "$f" ] && sed -i "s/librewolf %f/wisp %f/g" "$f"
            f="$home/.config/ferro/pinned.conf"
            [ -f "$f" ] && sed -i "s/librewolf/wisp/g; s/LibreWolf/Wisp/g" "$f"
            true' sh "$home" "$lw_gone"
    done
fi

# Wisp, the web browser, from its own newest build (after the packages, so
# the libraries a newer Wisp needs are there first). New builds are signed,
# and checked with minisign, as this update was.
if [ -x /usr/local/bin/ferro-wisp-update ]; then
    /usr/local/bin/ferro-wisp-update || true
fi

# Folio, FerroOS's own text editor, took Geany's place (v1.0.58): the
# default for text files, everyone's file associations, then its own newest
# build (signed, like Wisp's).
if [ -f /usr/local/share/applications/folio.desktop ]; then
    for f in /etc/xdg/mimeapps.list /etc/skel/.config/mimeapps.list; do
        [ -f "$f" ] || continue
        sed -i 's/=geany\.desktop/=folio.desktop/' "$f"
        grep -q '^text/plain=' "$f" || printf 'text/plain=folio.desktop\ntext/markdown=folio.desktop\n' >>"$f"
    done
    rm -rf /etc/skel/.config/geany
    getent passwd | while IFS=: read -r name _ uid gid _ home _; do
        [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
        # As them; "txt = geany %f", and a file's own "PATH<tab>geany %f".
        as_owner "$uid" "$gid" sh -c '
            f="$1/.config/mimeapps.list"
            [ -f "$f" ] && sed -i "s/=geany\\.desktop/=folio.desktop/" "$f"
            for f in "$1/.config/ferro/associations.conf" "$1/.config/ferro/file-associations.conf"; do
                [ -f "$f" ] && sed -i "s/\\([=[:space:]]\\)geany %f\$/\\1folio %f/" "$f"
            done
            f="$1/.config/ferro/pinned.conf"
            [ -f "$f" ] && sed -i "s/geany\\.desktop/folio.desktop/g" "$f"
            true' sh "$home"
    done
fi
if [ -x /usr/local/bin/ferro-folio-update ]; then
    /usr/local/bin/ferro-folio-update || true
fi

# Leaflet, FerroOS's own app for PDFs and documents (v1.0.73): its icon
# (icons don't come in the update), the default for PDF, DOCX, ODT and RTF
# where nothing was chosen for them (ferro-associations does the same for
# each person's own list), then its own newest build (signed, like Folio's).
if [ -f /usr/local/share/applications/leaflet.desktop ] && [ -f /usr/local/lib/ferro-heavy/leaflet/leaflet.py ]; then
    icon=/usr/local/share/icons/hicolor/scalable/apps/leaflet.svg
    [ -f "$icon" ] ||
        install -D -m 644 /usr/local/lib/ferro-heavy/leaflet/icons/hicolor/scalable/apps/leaflet.svg "$icon" 2>/dev/null || true
    # FILE: Leaflet for each kind nothing is chosen for (as root for the
    # system's lists, as each person for theirs).
    leaflet_default='leaflet_default() {
        [ -f "$1" ] && grep -q "^\[Default Applications\]" "$1" || return 0
        for kind in application/pdf application/vnd.openxmlformats-officedocument.wordprocessingml.document \
            application/vnd.oasis.opendocument.text application/rtf text/rtf; do
            grep -q "^$kind=" "$1" || sed -i "/^\[Default Applications\]/a $kind=leaflet.desktop" "$1"
        done
    }'
    eval "$leaflet_default"
    leaflet_default /etc/xdg/mimeapps.list
    leaflet_default /etc/skel/.config/mimeapps.list
    # Each person's own, as them.
    getent passwd | while IFS=: read -r name _ uid gid _ home _; do
        [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
        as_owner "$uid" "$gid" sh -c "$leaflet_default"'
            leaflet_default "$1/.config/mimeapps.list"' sh "$home"
    done
fi
if [ -x /usr/local/bin/ferro-leaflet-update ]; then
    /usr/local/bin/ferro-leaflet-update || true
fi

# Disk writes held in memory capped (not a share of memory), and BFQ for
# SATA and SD disks: both came later (see harden.sh).
# No typing into another terminal (TIOCSTI): came later (see harden.sh).
if [ -f /etc/sysctl.d/60-ferro-heavy.conf ] && ! grep -q '^dev.tty.legacy_tiocsti' /etc/sysctl.d/60-ferro-heavy.conf; then
    printf '%s\n' '# No typing into a terminal by a program that isn'"'"'t in it (TIOCSTI).' 'dev.tty.legacy_tiocsti = 0' >>/etc/sysctl.d/60-ferro-heavy.conf
