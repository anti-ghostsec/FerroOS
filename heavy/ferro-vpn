#!/bin/sh
# ferro-vpn: WireGuard VPN controller for FerroOS Heavy.
#
#   ferro-vpn on             bring up WireGuard tunnel
#   ferro-vpn off            disconnect WireGuard tunnel
#   ferro-vpn status         report current VPN state and connection details
#   ferro-vpn import < FILE  import a WireGuard config (given on standard
#                            input) into /etc/ferro/vpn.conf
#
# Runs as root: ferro-network calls it through sudo (see /etc/sudoers.d/60-ferro-vpn),
# which allows exactly these four command lines, without a password.
#
# So nothing given to it may make root do more than run a VPN:
# - import takes the config on standard input, never a file name: the caller
#   reads the file with its own rights, so root never opens a path someone
#   else chose (/etc/shadow, a link to it).
# - Every config is cut down to WireGuard's own settings before wg-quick sees
#   it. wg-quick runs PreUp/PostUp/PreDown/PostDown lines as root commands,
#   and SaveConfig writes back over the file: those, and anything unknown,
#   are left out.

set -u

CONF=/etc/ferro/vpn.conf
CONF_COMF=/etc/ferro/vpn.comf
WG_CONF=/etc/wireguard/wg0.conf
RUN=/run/ferro
STATUS=$RUN/vpn-status
WG_IFACE=wg0

usage() {
    echo "usage: ferro-vpn <on|off|status|import> (import reads the config from standard input)" >&2
    exit 2
}
ACTION=${1:-status}
[ $# -le 1 ] || usage
case "$ACTION" in on | off | status | import) ;; *) usage ;; esac

[ "$(id -u)" = 0 ] || exec sudo -n /usr/local/sbin/ferro-vpn "$ACTION"

set_status() {
    mkdir -p "$RUN" && chmod 755 "$RUN"
    printf "state=%s\ndetail=%s\ninterface=%s\n" "$1" "$2" "$3" >"$STATUS.tmp" && chmod 644 "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
}

# Standard input to standard output with only what a WireGuard config is
# made of: [Interface] and [Peer], comments, and these settings (any case).
clean_config() {
    awk '
        { line = $0; sub(/\r$/, "", line) }
        line ~ /^[ \t]*(#.*)?$/ { print line; next }
        line ~ /^[ \t]*\[(Interface|Peer)\][ \t]*$/ { print line; next }
        index(line, "=") {
            key = line
            sub(/=.*/, "", key)
            gsub(/[ \t]/, "", key)
            key = tolower(key)
            if (key ~ /^(privatekey|address|dns|mtu|listenport|fwmark|table|publickey|presharedkey|endpoint|allowedips|persistentkeepalive)$/) {
                print line
                next
            }
        }
        { dropped++ }
        END {
            if (dropped)
                printf "ferro-vpn: left out %d line(s) a VPN config doesn'\''t need (commands to run, unknown settings)\n", dropped >"/dev/stderr"
        }
    '
}

# install_config DEST: writes the config on standard input, cleaned, to DEST
# (mode 600). Through a new file renamed into place, so a link left at DEST
# is replaced, never written through. Fails, changing nothing, unless there's
# an [Interface] section.
install_config() {
    dir=$(dirname "$1")
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/.ferro-vpn.XXXXXX") || return 1
    if head -c 65536 | clean_config >"$tmp" && grep -q '^[[:space:]]*\[Interface\]' "$tmp"; then
        chmod 600 "$tmp" && mv -f "$tmp" "$1" && return 0
    fi
    rm -f "$tmp"
    return 1
}

# The account that ran sudo, for reading its own files with its own rights.
as_user() {
    case "${SUDO_UID:-}:${SUDO_GID:-}" in
        *[!0-9:]* | :* | *:) return 1 ;;
    esac
    setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --clear-groups -- "$@"
}

find_config() {
    if [ -f "$CONF" ] && [ -s "$CONF" ]; then
        echo "$CONF"
    elif [ -f "$CONF_COMF" ] && [ -s "$CONF_COMF" ]; then
        install_config "$CONF" <"$CONF_COMF" && rm -f "$CONF_COMF" && echo "$CONF"
    elif [ -n "${SUDO_USER:-}" ] && [ -f "$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)/.config/ferro/vpn.conf" ]; then
        user_conf="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)/.config/ferro/vpn.conf"
        as_user cat -- "$user_conf" | install_config "$CONF" && echo "$CONF"
    elif [ -f "$WG_CONF" ] && [ -s "$WG_CONF" ]; then
        echo "$WG_CONF"
    else
        echo ""
    fi
}

case "$ACTION" in
    on)
        CFG=$(find_config)
        if [ -z "$CFG" ]; then
            set_status "no_config" "Place config in /etc/ferro/vpn.conf" ""
            echo "ferro-vpn: no config found in /etc/ferro/vpn.conf" >&2
            exit 1
        fi

        mkdir -p /etc/wireguard
        chmod 700 /etc/wireguard
        # Bring down if already up (with the config it came up with).
        wg-quick down "$WG_CONF" 2>/dev/null || ip link delete dev "$WG_IFACE" 2>/dev/null || true

        # The tunnel's config, cleaned again: /etc/ferro is the sudo group's
        # to write in (Import's editor), so what's there is checked each time.
        if ! install_config "$WG_CONF" <"$CFG"; then
            set_status "error" "The VPN config has no [Interface] section" ""
            echo "ferro-vpn: $CFG isn't a WireGuard config" >&2
            exit 1
        fi

        if wg-quick up "$WG_CONF"; then
            ENDPOINT=$(wg show "$WG_IFACE" endpoints 2>/dev/null | awk "{print \$2}" | head -n1)
            DETAIL="WireGuard tunnel is active ($WG_IFACE)"
            [ -n "$ENDPOINT" ] && DETAIL="Connected ($ENDPOINT)"
            set_status "connected" "$DETAIL" "$WG_IFACE"
            echo "ferro-vpn: WireGuard connected ($WG_IFACE)"
            exit 0
        else
            set_status "error" "Failed to start WireGuard tunnel" ""
            echo "ferro-vpn: failed to start WireGuard" >&2
            exit 1
        fi
        ;;

    off)
        wg-quick down "$WG_CONF" 2>/dev/null || ip link delete dev "$WG_IFACE" 2>/dev/null || true
        set_status "disconnected" "WireGuard is disconnected." ""
        echo "ferro-vpn: WireGuard disconnected"
        exit 0
        ;;

    status)
        if ip link show dev "$WG_IFACE" >/dev/null 2>&1 && wg show "$WG_IFACE" >/dev/null 2>&1; then
            ENDPOINT=$(wg show "$WG_IFACE" endpoints 2>/dev/null | awk "{print \$2}" | head -n1)
            DETAIL="WireGuard tunnel is active ($WG_IFACE)"
            [ -n "$ENDPOINT" ] && DETAIL="Connected ($ENDPOINT)"
            set_status "connected" "$DETAIL" "$WG_IFACE"
            echo "state=connected"
            echo "detail=$DETAIL"
            echo "interface=$WG_IFACE"
        else
            CFG=$(find_config)
            if [ -n "$CFG" ]; then
                set_status "ready" "Config ready ($CFG). Click Apply to connect." ""
                echo "state=ready"
                echo "detail=Config ready ($CFG). Click Apply to connect."
            else
                set_status "no_config" "Place config in /etc/ferro/vpn.conf" ""
                echo "state=no_config"
                echo "detail=Place config in /etc/ferro/vpn.conf"
            fi
        fi
        ;;

    import)
        mkdir -p /etc/ferro /etc/wireguard
        chmod 775 /etc/ferro
        chown root:sudo /etc/ferro 2>/dev/null || true
        chmod 700 /etc/wireguard

        if ! install_config "$CONF"; then
            echo "ferro-vpn: what was given isn't a WireGuard config (no [Interface] section)" >&2
            exit 1
        fi
        install_config "$WG_CONF" <"$CONF" || true

        set_status "ready" "Imported. Click Apply to connect." ""
        echo "ferro-vpn: imported into $CONF"
        exit 0
        ;;
esac
