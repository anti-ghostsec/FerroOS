#!/bin/sh
# ferro-vpn: WireGuard VPN controller for FerroOS Heavy.
#
#   ferro-vpn on             bring up WireGuard tunnel
#   ferro-vpn off            disconnect WireGuard tunnel
#   ferro-vpn status         report current VPN state and connection details
#   ferro-vpn import < FILE  import a WireGuard config (given on standard
#                            input) into /etc/ferro/vpn.conf
#   ferro-vpn restore        at startup (ferro-vpn.service): the kill switch
#                            and the tunnel again, if the VPN was left on
#   ferro-vpn reapply        after the firewall reloads: the kill switch again
#   ferro-vpn killswitch on|off   whether the kill switch is used (on unless
#                            switched off)
#
# The kill switch: while the VPN is on, nothing leaves this machine except
# through the tunnel (wg0), the tunnel's own packets to the VPN server, and
# getting an address from the router. If wg0 goes away (the server, the
# network, a crash), everything else is blocked, programs and servers on
# this machine and what it forwards for VMs and containers alike, until
# the tunnel is back or the VPN is switched off. Its rules go in before
# the tunnel comes up, and at startup before the network does. Only for a
# config that sends everything through the tunnel (AllowedIPs 0.0.0.0/0):
# one that sends only some networks there would have the rest blocked.
#
# Runs as root: ferro-network calls it through sudo (see /etc/sudoers.d/60-ferro-vpn),
# which allows exactly these four command lines, without a password.
#
# So nothing given to it may make root do more than run a VPN:
# - import takes the config on standard input, never a file name: the caller
#   reads the file with its own rights, so root never opens a path someone
#   else chose (/etc/shadow, a link to it).
# - Every config is cut down to WireGuard's own settings before wg-quick sees
#   it. wg-quick runs PreUp/PostUp/PreDown/PostDown lines as root commands,
#   and SaveConfig writes back over the file: those, and anything unknown,
#   are left out.

set -u

CONF=/etc/ferro/vpn.conf
CONF_COMF=/etc/ferro/vpn.comf
WG_CONF=/etc/wireguard/wg0.conf
RUN=/run/ferro
STATUS=$RUN/vpn-status
WG_IFACE=wg0

usage() {
    echo "usage: ferro-vpn <on|off|status|import|restore|reapply|killswitch on|off> (import reads the config from standard input)" >&2
    exit 2
}
ACTION=${1:-status}
SWITCH=${2:-}
if [ "$ACTION" = killswitch ]; then
    [ $# -eq 2 ] && case "$SWITCH" in on | off) true ;; *) false ;; esac || usage
else
    [ $# -le 1 ] || usage
fi
case "$ACTION" in on | off | status | import | restore | reapply | killswitch) ;; *) usage ;; esac

[ "$(id -u)" = 0 ] || exec sudo -n /usr/local/sbin/ferro-vpn "$@"

# The VPN left on: kept across restarts. It holds the VPN server's
# addresses ("address port" a line), for when names can't be looked up
# (the kill switch blocks the lookup).
REMEMBER=/var/lib/ferro/vpn-on
KS_OFF=/var/lib/ferro/vpn-killswitch-off

set_status() {
    mkdir -p "$RUN" && chmod 755 "$RUN"
    printf "state=%s\ndetail=%s\ninterface=%s\n" "$1" "$2" "$3" >"$STATUS.tmp" && chmod 644 "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
}

# Standard input to standard output with only what a WireGuard config is
# made of: [Interface] and [Peer], comments, and these settings (any case).
clean_config() {
    awk '
        { line = $0; sub(/\r$/, "", line) }
        line ~ /^[ \t]*(#.*)?$/ { print line; next }
        line ~ /^[ \t]*\[(Interface|Peer)\][ \t]*$/ { print line; next }
        index(line, "=") {
            key = line
            sub(/=.*/, "", key)
            gsub(/[ \t]/, "", key)
            key = tolower(key)
            if (key ~ /^(privatekey|address|dns|mtu|listenport|fwmark|table|publickey|presharedkey|endpoint|allowedips|persistentkeepalive)$/) {
                print line
                next
            }
        }
        { dropped++ }
        END {
            if (dropped)
                printf "ferro-vpn: left out %d line(s) a VPN config doesn'\''t need (commands to run, unknown settings)\n", dropped >"/dev/stderr"
        }
    '
}

# install_config DEST: writes the config on standard input, cleaned, to DEST
# (mode 600). Through a new file renamed into place, so a link left at DEST
# is replaced, never written through. Fails, changing nothing, unless there's
# an [Interface] section.
install_config() {
    dir=$(dirname "$1")
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/.ferro-vpn.XXXXXX") || return 1
    if head -c 65536 | clean_config >"$tmp" && grep -q '^[[:space:]]*\[Interface\]' "$tmp"; then
        chmod 600 "$tmp" && mv -f "$tmp" "$1" && return 0
    fi
    rm -f "$tmp"
    return 1
}

# The account that ran sudo, for reading its own files with its own rights.
as_user() {
    case "${SUDO_UID:-}:${SUDO_GID:-}" in
        *[!0-9:]* | :* | *:) return 1 ;;
    esac
    setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --clear-groups -- "$@"
}

# The VPN servers in a config, "address port" a line, names looked up.
servers() {
    sed -n 's/^[[:space:]]*[Ee][Nn][Dd][Pp][Oo][Ii][Nn][Tt][[:space:]]*=[[:space:]]*//p' "$1" | tr -d ' \r' |
        while read -r ep; do
            port=${ep##*:}
            host=${ep%:*}
            host=${host#[}
            host=${host%]}
            case "$port" in "" | *[!0-9]*) continue ;; esac
            case "$host" in
            *:* | *[0-9].*[0-9].*[0-9].*[0-9]) printf '%s %s\n' "$host" "$port" ;;
            *) getent ahosts "$host" 2>/dev/null | awk -v p="$port" '{ print $1, p }' | sort -u ;;
            esac
        done | grep -E '^[0-9a-fA-F:.]+ [0-9]+$'
}

# A config that sends everything through the tunnel.
full_tunnel() {
    grep -iE '^[[:space:]]*AllowedIPs[[:space:]]*=' "$1" | grep -qE '(^|[=, ])(0\.0\.0\.0/0|::/0)([, ]|$)'
}

# Endpoint names in the tunnel's config become the addresses looked up
# (the first of each): with the kill switch on, wg-quick couldn't look
# them up itself. SERVERS is servers()' output.
pin_endpoints() { # pin_endpoints CONFIG SERVERS
    printf '%s\n' "$2" >"$1.servers"
    awk -v servers="$1.servers" '
        BEGIN { while ((getline l < servers) > 0) { split(l, f, " "); if (!(f[2] in ip)) ip[f[2]] = f[1] } }
        tolower($0) ~ /^[ \t]*endpoint[ \t]*=/ {
            v = $0; sub(/^[^=]*=[ \t]*/, "", v); gsub(/[ \t\r]/, "", v)
            port = v; sub(/.*:/, "", port); host = v; sub(/:[0-9]+$/, "", host)
            if (host !~ /^[0-9.]+$/ && host !~ /:/ && host !~ /^\[/ && (port in ip)) {
                a = ip[port]; if (a ~ /:/) a = "[" a "]"
                print "Endpoint = " a ":" port; next
            }
        }
        { print }
    ' "$1" >"$1.pinned" && chmod 600 "$1.pinned" && mv -f "$1.pinned" "$1"
    rm -f "$1.servers"
}

killswitch_wanted() { [ ! -e "$KS_OFF" ]; }

# The rules: SERVERS ("address port" lines) may be reached directly, all
# else only through wg0.
killswitch_on() { # killswitch_on SERVERS
    e4=
    e6=
    for line in $(printf '%s\n' "$1" | tr ' ' '|'); do
        a=${line%|*}
        p=${line#*|}
        case "$a" in
        *:*) e6="$e6${e6:+, }$a . $p" ;;
        *) e4="$e4${e4:+, }$a . $p" ;;
        esac
    done
    s4=
    s6=
    [ -z "$e4" ] || s4="elements = { $e4 }"
    [ -z "$e6" ] || s6="elements = { $e6 }"
    nft -f - <<EOF
table inet ferro_vpn
delete table inet ferro_vpn
table inet ferro_vpn {
    set servers4 {
        type ipv4_addr . inet_service
        $s4
    }
    set servers6 {
        type ipv6_addr . inet_service
        $s6
    }
    chain filter_out {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
        oifname "$WG_IFACE" accept
        ip daddr . udp dport @servers4 accept
        ip6 daddr . udp dport @servers6 accept
        # Getting an address from the router, and the neighbour discovery
        # IPv6 needs on the link itself.
        udp sport 68 udp dport 67 accept
        udp sport 546 udp dport 547 accept
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        meta l4proto tcp reject with tcp reset
        reject
    }
    chain filter_forward {
        type filter hook forward priority filter; policy drop;
        oifname "$WG_IFACE" accept
        iifname "$WG_IFACE" accept
        reject
    }
}
EOF
}

killswitch_off() {
    nft delete table inet ferro_vpn 2>/dev/null || true
}

killswitch_active() {
    nft list table inet ferro_vpn >/dev/null 2>&1
}

find_config() {
    if [ -f "$CONF" ] && [ -s "$CONF" ]; then
        echo "$CONF"
    elif [ -f "$CONF_COMF" ] && [ -s "$CONF_COMF" ]; then
        install_config "$CONF" <"$CONF_COMF" && rm -f "$CONF_COMF" && echo "$CONF"
    elif [ -n "${SUDO_USER:-}" ] && [ -f "$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)/.config/ferro/vpn.conf" ]; then
        user_conf="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)/.config/ferro/vpn.conf"
        as_user cat -- "$user_conf" | install_config "$CONF" && echo "$CONF"
    elif [ -f "$WG_CONF" ] && [ -s "$WG_CONF" ]; then
        echo "$WG_CONF"
    else
        echo ""
    fi
}

case "$ACTION" in
    on)
        if ! command -v wg-quick >/dev/null 2>&1; then
            set_status "error" "WireGuard's tools aren't installed: run Updates (Settings), then try again." ""
            echo "ferro-vpn: wg-quick isn't installed (sudo apt install wireguard-tools, or ferro-update)" >&2
            exit 1
        fi
        CFG=$(find_config)
        if [ -z "$CFG" ]; then
            set_status "no_config" "Place config in /etc/ferro/vpn.conf" ""
            echo "ferro-vpn: no config found in /etc/ferro/vpn.conf" >&2
            exit 1
        fi

        mkdir -p /etc/wireguard
        chmod 700 /etc/wireguard
        # The tunnel's config, cleaned again: /etc/ferro is the sudo group's
        # to write in (Import's editor), so what's there is checked each time.
        NEW=/etc/wireguard/.$WG_IFACE.new
        if ! install_config "$NEW" <"$CFG"; then
            rm -f "$NEW"
            set_status "error" "The VPN config has no [Interface] section" ""
            echo "ferro-vpn: $CFG isn't a WireGuard config" >&2
            exit 1
        fi

        # The servers, looked up now; or as last time, when the kill switch
        # (still on from before) blocks looking them up.
        SERVERS=$(servers "$NEW")
        [ -n "$SERVERS" ] || SERVERS=$(grep -E '^[0-9a-fA-F:.]+ [0-9]+$' "$REMEMBER" 2>/dev/null)
        pin_endpoints "$NEW" "$SERVERS"
        KS=""
        if killswitch_wanted && full_tunnel "$NEW"; then
            if [ -z "$SERVERS" ]; then
                rm -f "$NEW"
                set_status "error" "Couldn't find the VPN server's address (Endpoint in the config)." ""
                echo "ferro-vpn: no server address in the config, or it can't be looked up" >&2
                exit 1
            fi
            # Before any tunnel goes down or comes up: nothing gets out
            # around it meanwhile.
            if killswitch_on "$SERVERS"; then
                KS=" Kill switch on."
            else
                rm -f "$NEW"
                set_status "error" "The kill switch couldn't be set up, so the VPN wasn't started." ""
                echo "ferro-vpn: couldn't load the kill switch rules (nft)" >&2
                exit 1
            fi
        fi
        mkdir -p -m 755 "${REMEMBER%/*}"
        printf '%s\n' "$SERVERS" >"$REMEMBER"

        # Bring down if already up (with the config it came up with).
        wg-quick down "$WG_CONF" 2>/dev/null || ip link delete dev "$WG_IFACE" 2>/dev/null || true
        mv -f "$NEW" "$WG_CONF"
        [ -n "$KS" ] || killswitch_off

        if OUT=$(wg-quick up "$WG_CONF" 2>&1); then
            ENDPOINT=$(wg show "$WG_IFACE" endpoints 2>/dev/null | awk "{print \$2}" | head -n1)
            # wg-quick is done once the interface is there, whether or not
            # the server answers: it's connected only when the server has
            # (a handshake), so wait a few seconds for one.
            n=0
            while [ "$n" -lt 8 ]; do
                [ "$(wg show "$WG_IFACE" latest-handshakes 2>/dev/null | awk '$2 > 0' | wc -l)" -gt 0 ] && break
                sleep 1
                n=$((n + 1))
            done
            if [ "$n" -ge 8 ]; then
                # Left up: with the tunnel there nothing leaks out around it.
                set_status "no_answer" "No answer from the VPN server${ENDPOINT:+ ($ENDPOINT)}. Is this config also in use on another PC? Each needs its own.$KS" "$WG_IFACE"
                echo "ferro-vpn: the tunnel is up, but no handshake from ${ENDPOINT:-the server}: is this config in use on another PC (each needs its own keys), is UDP to it blocked on this network, or is the clock wrong?" >&2
                exit 0
            fi
            DETAIL="WireGuard tunnel is active ($WG_IFACE)"
            [ -n "$ENDPOINT" ] && DETAIL="Connected ($ENDPOINT)"
            set_status "connected" "$DETAIL.$KS" "$WG_IFACE"
            echo "ferro-vpn: WireGuard connected ($WG_IFACE).$KS"
            exit 0
        else
            # What wg-quick said, as the reason: "RTNETLINK answers: File
            # exists" is a route this network already has (its addresses
            # overlap the VPN's), "resolvconf: command not found" its DNS.
            WHY=$(printf '%s\n' "$OUT" | grep -v '^\[#\]' | tail -n1)
            printf '%s\n' "$OUT" >&2
            wg-quick down "$WG_CONF" >/dev/null 2>&1 || ip link delete dev "$WG_IFACE" 2>/dev/null || true
            case "$WHY" in
                *"File exists"*) WHY="This network's addresses overlap the VPN's (a route is already there)." ;;
                "") WHY="Failed to start WireGuard tunnel" ;;
                *) WHY="Couldn't start WireGuard: $WHY" ;;
            esac
            # The VPN is still wanted: with the kill switch, nothing goes
            # out until it's working or switched off.
            if killswitch_active; then
                set_status "blocked" "$WHY The internet is blocked until the VPN works or is switched off (kill switch)." ""
            else
                set_status "error" "$WHY" ""
            fi
            echo "ferro-vpn: failed to start WireGuard" >&2
            exit 1
        fi
        ;;

    off)
        rm -f "$REMEMBER"
        wg-quick down "$WG_CONF" 2>/dev/null || ip link delete dev "$WG_IFACE" 2>/dev/null || true
        killswitch_off
        set_status "disconnected" "WireGuard is disconnected." ""
        echo "ferro-vpn: WireGuard disconnected"
        exit 0
        ;;

    status)
        if ip link show dev "$WG_IFACE" >/dev/null 2>&1 && wg show "$WG_IFACE" >/dev/null 2>&1; then
            ENDPOINT=$(wg show "$WG_IFACE" endpoints 2>/dev/null | awk "{print \$2}" | head -n1)
            DETAIL="WireGuard tunnel is active ($WG_IFACE)"
            [ -n "$ENDPOINT" ] && DETAIL="Connected ($ENDPOINT)"
            set_status "connected" "$DETAIL" "$WG_IFACE"
            echo "state=connected"
            echo "detail=$DETAIL"
            echo "interface=$WG_IFACE"
        elif [ -f "$REMEMBER" ] && killswitch_active; then
            DETAIL="The VPN dropped: the internet is blocked until it's back (kill switch). Switch the VPN off to go online without it."
            set_status "blocked" "$DETAIL" ""
            echo "state=blocked"
            echo "detail=$DETAIL"
        else
            CFG=$(find_config)
            if [ -n "$CFG" ]; then
                set_status "ready" "Config ready ($CFG). Click Apply to connect." ""
                echo "state=ready"
                echo "detail=Config ready ($CFG). Click Apply to connect."
            else
                set_status "no_config" "Place config in /etc/ferro/vpn.conf" ""
                echo "state=no_config"
                echo "detail=Place config in /etc/ferro/vpn.conf"
            fi
        fi
        ;;

    restore)
        # Left on: the kill switch before the network comes up (this runs
        # before it), then the tunnel, which connects once there's a network.
        [ -f "$REMEMBER" ] || { set_status "disconnected" "WireGuard is disconnected." ""; exit 0; }
        SERVERS=$(grep -E '^[0-9a-fA-F:.]+ [0-9]+$' "$REMEMBER")
        if killswitch_wanted && [ -f "$WG_CONF" ] && full_tunnel "$WG_CONF"; then
            # Without the server's address, nothing gets out at all: better
            # than everything getting out around the tunnel.
            killswitch_on "$SERVERS" || killswitch_on ""
        fi
        if [ -f "$WG_CONF" ] && command -v wg-quick >/dev/null 2>&1 && wg-quick up "$WG_CONF" >/dev/null 2>&1; then
            set_status "connecting" "Connecting to the VPN..." "$WG_IFACE"
        else
            set_status "error" "The VPN couldn't be started again after the restart." ""
        fi
        exit 0
        ;;

    reapply)
        # The firewall service was (re)started, which clears every rule.
        if [ -f "$REMEMBER" ] && killswitch_wanted && [ -f "$WG_CONF" ] && full_tunnel "$WG_CONF"; then
            killswitch_on "$(grep -E '^[0-9a-fA-F:.]+ [0-9]+$' "$REMEMBER")"
        fi
        exit 0
        ;;

    killswitch)
        mkdir -p -m 755 "${KS_OFF%/*}"
        if [ "$SWITCH" = off ]; then
            : >"$KS_OFF"
            killswitch_off
            echo "ferro-vpn: kill switch off: if the VPN drops, traffic goes out directly."
        else
            rm -f "$KS_OFF"
            echo "ferro-vpn: kill switch on (from the next time the VPN is switched on)."
            if [ -f "$REMEMBER" ] && [ -f "$WG_CONF" ] && full_tunnel "$WG_CONF"; then
                killswitch_on "$(grep -E '^[0-9a-fA-F:.]+ [0-9]+$' "$REMEMBER")" && echo "ferro-vpn: and on now."
            fi
        fi
        exit 0
        ;;

    import)
        mkdir -p /etc/ferro /etc/wireguard
        chmod 775 /etc/ferro
        chown root:sudo /etc/ferro 2>/dev/null || true
        chmod 700 /etc/wireguard

        if ! install_config "$CONF"; then
            echo "ferro-vpn: what was given isn't a WireGuard config (no [Interface] section)" >&2
            exit 1
        fi
        install_config "$WG_CONF" <"$CONF" || true

        set_status "ready" "Imported. Click Apply to connect." ""
        echo "ferro-vpn: imported into $CONF"
        exit 0
        ;;
esac
