#!/bin/sh
# ferro-vpn: WireGuard VPN controller for FerroOS Heavy.
#
#   ferro-vpn on             bring up WireGuard tunnel
#   ferro-vpn off            disconnect WireGuard tunnel
#   ferro-vpn status         report current VPN state and connection details
#   ferro-vpn import [NAME] < FILE  add a WireGuard config (given on
#                            standard input) to the list of configs
#   ferro-vpn list           the configs: "ID name", the one in use marked
#   ferro-vpn use ID         use that config (now, if the VPN is on)
#   ferro-vpn remove ID      take that config off the list
#   ferro-vpn watch          the service (ferro-vpn-watch): switches to the
#                            next config when the VPN server stops answering
#   ferro-vpn restore        at startup (ferro-vpn.service): the kill switch
#                            and the tunnel again, if the VPN was left on
#   ferro-vpn reapply        after the firewall reloads: the kill switch again
#   ferro-vpn killswitch on|off   whether the kill switch is used (on unless
#                            switched off)
#
# The kill switch: while the VPN is on, nothing leaves this machine except
# through the tunnel (wg0), the tunnel's own packets to the VPN server, and
# getting an address from the router. If wg0 goes away (the server, the
# network, a crash), everything else is blocked, programs and servers on
# this machine and what it forwards for VMs and containers alike, until
# the tunnel is back or the VPN is switched off. Its rules go in before
# the tunnel comes up, and at startup before the network does. Only for a
# config that sends everything through the tunnel (AllowedIPs 0.0.0.0/0):
# one that sends only some networks there would have the rest blocked.
#
# Lookups (DNS): while the kill switch guards the tunnel, only the VPN's
# own DNS servers (the config's DNS line) are asked, inside the tunnel:
# the VPN already sees every connection, so FerroOS's usual DNS over TLS
# (Quad9, Cloudflare) would only add a second company that sees them. Its
# own come back when the VPN is switched off; Tor's, when Tor is on, still
# win (ferro-tor's settings come after these).
#
# The configs: a list (/etc/ferro/vpn.d, in the order they were added).
# While the VPN is on, ferro-vpn watch checks every 15 seconds that its
# server still answers (anything back through the tunnel after a probe
# sent through it); after two checks without an answer, it switches to the
# next config on the list, and on round. The kill switch lets every listed
# server be reached, so the switch works with everything else blocked.
#
# Runs as root: ferro-network calls it through sudo (see /etc/sudoers.d/60-ferro-vpn),
# which allows exactly these three command lines, without a password.
#
# So nothing given to it may make root do more than run a VPN:
# - import takes the config on standard input, never a file name: the caller
#   reads the file with its own rights, so root never opens a path someone
#   else chose (/etc/shadow, a link to it).
# - Every config is cut down to WireGuard's own settings before wg-quick sees
#   it. wg-quick runs PreUp/PostUp/PreDown/PostDown lines as root commands,
#   and SaveConfig writes back over the file: those, and anything unknown,
#   are left out.

set -u

CONF=/etc/ferro/vpn.conf
CONF_COMF=/etc/ferro/vpn.comf
WG_CONF=/etc/wireguard/wg0.conf
RUN=/run/ferro
STATUS=$RUN/vpn-status
WG_IFACE=wg0

usage() {
    echo "usage: ferro-vpn <on|off|status|import [NAME]|list|use ID|remove ID|watch|restore|reapply|killswitch on|off> (import reads the config from standard input)" >&2
    exit 2
}
ACTION=${1:-status}
SWITCH=${2:-}
case "$ACTION" in
killswitch) [ $# -eq 2 ] && case "$SWITCH" in on | off) true ;; *) false ;; esac || usage ;;
import) [ $# -le 2 ] || usage ;;
use | remove) [ $# -eq 2 ] && case "$SWITCH" in */* | .* | *[!A-Za-z0-9_-]*) false ;; [0-9][0-9]-*) true ;; *) false ;; esac || usage ;;
on | off | status | list | watch | restore | reapply) [ $# -le 1 ] || usage ;;
*) usage ;;
esac

# (Switching it off asks for the password: sudo asks, in a terminal.)
[ "$(id -u)" = 0 ] || exec sudo /usr/local/sbin/ferro-vpn "$@"

# The VPN left on: kept across restarts. It holds the VPN server's
# addresses ("address port" a line), for when names can't be looked up
# (the kill switch blocks the lookup).
REMEMBER=/var/lib/ferro/vpn-on
KS_OFF=/var/lib/ferro/vpn-killswitch-off
# The list of configs ("NN-name.conf"), the one in use (its ID), and each
# one's servers as last looked up (with the kill switch on and the tunnel
# down, names can't be looked up).
LIST=/etc/ferro/vpn.d
USING=/var/lib/ferro/vpn-using
CACHE=/var/lib/ferro/vpn-servers
ADDR='^[0-9a-fA-F:.]+ [0-9]+$'

# One change at a time (the watcher and a person at once); a ferro-vpn
# started by this one already has it.
mkdir -p -m 755 "$RUN" /var/lib/ferro
case "$ACTION" in
status | list) ;;
*)
    if [ -z "${FERRO_VPN_LOCKED:-}" ] && [ "$ACTION" != watch ] && command -v flock >/dev/null 2>&1; then
        exec 9>"$RUN/vpn.lock"
        flock 9
        export FERRO_VPN_LOCKED=1
    fi
    ;;
esac

set_status() {
    mkdir -p "$RUN" && chmod 755 "$RUN"
    # The watcher's word on why this config is in use, first.
    printf "state=%s\ndetail=%s%s\ninterface=%s\n" "$1" "${FERRO_VPN_NOTE:-}" "$2" "$3" >"$STATUS.tmp" && chmod 644 "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
}

# Standard input to standard output with only what a WireGuard config is
# made of: [Interface] and [Peer], comments, and these settings (any case).
clean_config() {
    awk '
        { line = $0; sub(/\r$/, "", line) }
        # Saved by a Windows program: a byte-order mark before [Interface].
        NR == 1 { sub(/^\357\273\277/, "", line) }
        line ~ /^[ \t]*(#.*)?$/ { print line; next }
        line ~ /^[ \t]*\[(Interface|Peer)\][ \t]*$/ { print line; next }
        index(line, "=") {
            key = line
            sub(/=.*/, "", key)
            gsub(/[ \t]/, "", key)
            key = tolower(key)
            if (key ~ /^(privatekey|address|dns|mtu|listenport|fwmark|table|publickey|presharedkey|endpoint|allowedips|persistentkeepalive)$/) {
                print line
                next
            }
        }
        { dropped++ }
        END {
            if (dropped)
                printf "ferro-vpn: left out %d line(s) a VPN config doesn'\''t need (commands to run, unknown settings)\n", dropped >"/dev/stderr"
        }
    '
}

# install_config DEST: writes the config on standard input, cleaned, to DEST
# (mode 600). Through a new file renamed into place, so a link left at DEST
# is replaced, never written through. Fails, changing nothing, unless there's
# an [Interface] section.
install_config() {
    dir=$(dirname "$1")
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/.ferro-vpn.XXXXXX") || return 1
    if head -c 65536 | clean_config >"$tmp" && grep -q '^[[:space:]]*\[Interface\]' "$tmp"; then
        chmod 600 "$tmp" && mv -f "$tmp" "$1" && return 0
    fi
    rm -f "$tmp"
    return 1
}

# The VPN servers in a config, "address port" a line, names looked up.
servers() {
    sed -n 's/^[[:space:]]*[Ee][Nn][Dd][Pp][Oo][Ii][Nn][Tt][[:space:]]*=[[:space:]]*//p' "$1" | tr -d ' \r' |
        while read -r ep; do
            port=${ep##*:}
            host=${ep%:*}
            host=${host#[}
            host=${host%]}
            case "$port" in "" | *[!0-9]*) continue ;; esac
            case "$host" in
            *:* | *[0-9].*[0-9].*[0-9].*[0-9]) printf '%s %s\n' "$host" "$port" ;;
            *) getent ahosts "$host" 2>/dev/null | awk -v p="$port" '{ print $1, p }' | sort -u ;;
            esac
        done | grep -E '^[0-9a-fA-F:.]+ [0-9]+$'
}

# A config that sends everything through the tunnel.
full_tunnel() {
    ips=$(grep -iE '^[[:space:]]*AllowedIPs[[:space:]]*=' "$1")
    printf '%s\n' "$ips" | grep -qE '(^|[=, ])(0\.0\.0\.0/0|::/0)([, ]|$)' && return 0
    # Or the whole of it in halves, as some providers write it
    # (0.0.0.0/1 and 128.0.0.0/1; ::/1 and 8000::/1).
    { printf '%s\n' "$ips" | grep -qE '(^|[=, ])0\.0\.0\.0/1([, ]|$)' && printf '%s\n' "$ips" | grep -qE '(^|[=, ])128\.0\.0\.0/1([, ]|$)'; } ||
        { printf '%s\n' "$ips" | grep -qE '(^|[=, ])::/1([, ]|$)' && printf '%s\n' "$ips" | grep -qiE '(^|[=, ])8000::/1([, ]|$)'; }
}

# Endpoint names in the tunnel's config become the addresses looked up
# (the first of each): with the kill switch on, wg-quick couldn't look
# them up itself. SERVERS is servers()' output.
pin_endpoints() { # pin_endpoints CONFIG SERVERS
    printf '%s\n' "$2" >"$1.servers"
    awk -v servers="$1.servers" '
        BEGIN { while ((getline l < servers) > 0) { split(l, f, " "); if (!(f[2] in ip)) ip[f[2]] = f[1] } }
        tolower($0) ~ /^[ \t]*endpoint[ \t]*=/ {
            v = $0; sub(/^[^=]*=[ \t]*/, "", v); gsub(/[ \t\r]/, "", v)
            port = v; sub(/.*:/, "", port); host = v; sub(/:[0-9]+$/, "", host)
            if (host !~ /^[0-9.]+$/ && host !~ /:/ && host !~ /^\[/ && (port in ip)) {
                a = ip[port]; if (a ~ /:/) a = "[" a "]"
                print "Endpoint = " a ":" port; next
            }
        }
        { print }
    ' "$1" >"$1.pinned" && chmod 600 "$1.pinned" && mv -f "$1.pinned" "$1"
    rm -f "$1.servers"
}

killswitch_wanted() { [ ! -e "$KS_OFF" ]; }

# Somewhere through the tunnel, for the watcher's probe: the VPN's DNS
# server, or (all traffic through it) Quad9, or the first network it
# carries.
probe_address() {
    a=$(vpn_dns_servers | grep -v : | head -n1)
    [ -n "$a" ] || ! full_tunnel "$WG_CONF" || a=9.9.9.9
    [ -n "$a" ] || a=$(sed -n 's/^[[:space:]]*[Aa][Ll][Ll][Oo][Ww][Ee][Dd][Ii][Pp][Ss][[:space:]]*=//p' "$WG_CONF" | tr ', ' '\n\n' |
        grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -n1 | awk -F'[./]' '{ d = $4; if ($5 != "32" && d == 0) d = 1; print $1 "." $2 "." $3 "." d }')
    echo "${a:-9.9.9.9}"
}

# Sorted after FerroOS's own DNS settings (60-ferro-heavy.conf) and before
# Tor's (60-ferro-tor.conf), which take over when Tor is on.
VPN_DNS=/run/systemd/resolved.conf.d/60-ferro-the-vpn.conf

# The VPN's DNS servers, from the tunnel's config (its DNS line also holds
# search domains: only addresses).
vpn_dns_servers() {
    sed -n 's/^[[:space:]]*[Dd][Nn][Ss][[:space:]]*=//p' "$WG_CONF" 2>/dev/null | tr ', \r' '\n\n\n' |
        grep -E '^[0-9a-fA-F:.]+$' | grep -E '[.:]'
}

# Only the VPN's DNS, on wg0, in plain DNS (the tunnel is the encryption;
# a VPN's DNS server rarely speaks DNS over TLS). Nothing changes when the
# config names none. DNSNOTE says what was done, for the status line.
vpn_dns_on() {
    DNSNOTE=""
    servers=$(vpn_dns_servers)
    [ -n "$servers" ] || return 0
    command -v resolvectl >/dev/null 2>&1 || return 0
    mkdir -p -m 755 "${VPN_DNS%/*}"
    printf '[Resolve]\nDNS=\nDomains=\n' >"$VPN_DNS.tmp" && chmod 644 "$VPN_DNS.tmp" && mv -f "$VPN_DNS.tmp" "$VPN_DNS"
    systemctl reload-or-restart systemd-resolved 2>/dev/null
    # shellcheck disable=SC2086
    resolvectl dns "$WG_IFACE" $servers 2>/dev/null &&
        resolvectl domain "$WG_IFACE" '~.' 2>/dev/null &&
        resolvectl dnsovertls "$WG_IFACE" no 2>/dev/null &&
        resolvectl default-route "$WG_IFACE" yes 2>/dev/null &&
        DNSNOTE=" Lookups through the VPN's DNS."
}

vpn_dns_off() {
    [ -f "$VPN_DNS" ] || return 0
    rm -f "$VPN_DNS"
    systemctl reload-or-restart systemd-resolved 2>/dev/null || true
}

# The rules: SERVERS ("address port" lines) may be reached directly, all
# else only through wg0.
killswitch_on() { # killswitch_on SERVERS
    e4=
    e6=
    for line in $(printf '%s\n' "$1" | tr ' ' '|'); do
        a=${line%|*}
        p=${line#*|}
        case "$a" in
        *:*) e6="$e6${e6:+, }$a . $p" ;;
        *) e4="$e4${e4:+, }$a . $p" ;;
        esac
    done
    s4=
    s6=
    [ -z "$e4" ] || s4="elements = { $e4 }"
    [ -z "$e6" ] || s6="elements = { $e6 }"
    nft -f - <<EOF
table inet ferro_vpn
delete table inet ferro_vpn
table inet ferro_vpn {
    set servers4 {
        type ipv4_addr . inet_service
        $s4
    }
    set servers6 {
        type ipv6_addr . inet_service
        $s6
    }
    chain filter_out {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
        oifname "$WG_IFACE" accept
        ip daddr . udp dport @servers4 accept
        ip6 daddr . udp dport @servers6 accept
        # Getting an address from the router, and the neighbour discovery
        # IPv6 needs on the link itself.
        udp sport 68 udp dport 67 accept
        udp sport 546 udp dport 547 accept
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        meta l4proto tcp reject with tcp reset
        reject
    }
    chain filter_forward {
        type filter hook forward priority filter; policy drop;
        oifname "$WG_IFACE" accept
        iifname "$WG_IFACE" accept
        reject
    }
}
EOF
}

killswitch_off() {
    nft delete table inet ferro_vpn 2>/dev/null || true
}

killswitch_active() {
    nft list table inet ferro_vpn >/dev/null 2>&1
}

# The configs on the list, by ID, in order. A config from before there
# was a list (/etc/ferro/vpn.conf) becomes its first.
ids() {
    if ! ls "$LIST"/[0-9][0-9]-*.conf >/dev/null 2>&1 && [ -s "$CONF" ] && [ "$(id -u)" = 0 ]; then
        mkdir -p -m 755 "$LIST"
        install_config "$LIST/01-main.conf" <"$CONF" && set_using 01-main
    fi
    for f in "$LIST"/[0-9][0-9]-*.conf; do
        [ -f "$f" ] && basename "$f" .conf
    done
}

# The one in use: as chosen, or the first.
using_id() {
    u=$(cat "$USING" 2>/dev/null)
    all=$(ids)
    if [ -n "$u" ] && printf '%s\n' "$all" | grep -qxF "$u"; then
        echo "$u"
    else
        printf '%s\n' "$all" | head -n1
    fi
}

# The one after ID (the first after the last); ID itself if it's alone.
next_id() {
    all=$(ids)
    n=$(printf '%s\n' "$all" | grep -A1 -xF "$1" | sed -n 2p)
    [ -n "$n" ] || n=$(printf '%s\n' "$all" | head -n1)
    echo "$n"
}

name_of() { echo "${1#[0-9][0-9]-}"; }

# Readable by everyone (root's umask is 077): the Network window shows it.
set_using() {
    echo "$1" >"$USING.tmp" && chmod 644 "$USING.tmp" && mv -f "$USING.tmp" "$USING"
}

# Every listed server, as last looked up: the kill switch lets them all be
# reached, so another config can be switched to with everything blocked.
all_servers() { # all_servers MORE
    { printf '%s\n' "$1"; cat "$CACHE"/* 2>/dev/null; } | grep -E "$ADDR" | sort -u
}

find_config() {
    u=$(using_id)
    if [ -n "$u" ]; then
        echo "$LIST/$u.conf"
    elif [ -f "$CONF" ] && [ -s "$CONF" ]; then
        echo "$CONF"
    elif [ -f "$CONF_COMF" ] && [ -s "$CONF_COMF" ]; then
        install_config "$CONF" <"$CONF_COMF" && rm -f "$CONF_COMF" && echo "$CONF"
    elif [ -f "$WG_CONF" ] && [ -s "$WG_CONF" ]; then
        echo "$WG_CONF"
    else
        echo ""
    fi
}

case "$ACTION" in
    on)
        if ! command -v wg-quick >/dev/null 2>&1; then
            set_status "error" "WireGuard's tools aren't installed: run Updates (Settings), then try again." ""
            echo "ferro-vpn: wg-quick isn't installed (sudo apt install wireguard-tools, or ferro-update)" >&2
            exit 1
        fi
        CFG=$(find_config)
        if [ -z "$CFG" ]; then
            set_status "no_config" "Place config in /etc/ferro/vpn.conf" ""
            echo "ferro-vpn: no config found in /etc/ferro/vpn.conf" >&2
            exit 1
        fi

        mkdir -p /etc/wireguard
        chmod 700 /etc/wireguard
        # The tunnel's config, cleaned again: /etc/ferro is the sudo group's
        # to write in (Import's editor), so what's there is checked each time.
        NEW=/etc/wireguard/.$WG_IFACE.new
        if ! install_config "$NEW" <"$CFG"; then
            rm -f "$NEW"
            set_status "error" "The VPN config has no [Interface] section" ""
            echo "ferro-vpn: $CFG isn't a WireGuard config" >&2
            exit 1
        fi

        # The servers, looked up now; or as last time, when the kill switch
        # (still on from before) blocks looking them up.
        ID=$(using_id)
        SERVERS=$(servers "$NEW")
        if [ -n "$SERVERS" ] && [ -n "$ID" ]; then
            mkdir -p -m 700 "$CACHE" && printf '%s\n' "$SERVERS" >"$CACHE/$ID"
        fi
        [ -n "$SERVERS" ] || SERVERS=$(grep -E "$ADDR" "$CACHE/$ID" 2>/dev/null)
        [ -n "$SERVERS" ] || SERVERS=$(grep -E "$ADDR" "$REMEMBER" 2>/dev/null)
        pin_endpoints "$NEW" "$SERVERS"
        KS=""
        if killswitch_wanted && full_tunnel "$NEW"; then
            if [ -z "$SERVERS" ]; then
                rm -f "$NEW"
                set_status "error" "Couldn't find the VPN server's address (Endpoint in the config)." ""
                echo "ferro-vpn: no server address in the config, or it can't be looked up" >&2
                exit 1
            fi
            # Before any tunnel goes down or comes up: nothing gets out
            # around it meanwhile.
            if killswitch_on "$(all_servers "$SERVERS")"; then
                KS=" Kill switch on."
            else
                rm -f "$NEW"
                set_status "error" "The kill switch couldn't be set up, so the VPN wasn't started." ""
                echo "ferro-vpn: couldn't load the kill switch rules (nft)" >&2
                exit 1
            fi
        fi
        mkdir -p -m 755 "${REMEMBER%/*}"
        all_servers "$SERVERS" >"$REMEMBER"
        [ -z "$ID" ] || [ "$CFG" = "$CONF" ] || install_config "$CONF" <"$CFG" || true

        # Bring down if already up (with the config it came up with).
        wg-quick down "$WG_CONF" 2>/dev/null || ip link delete dev "$WG_IFACE" 2>/dev/null || true
        mv -f "$NEW" "$WG_CONF"
        [ -n "$KS" ] || killswitch_off

        if OUT=$(wg-quick up "$WG_CONF" 2>&1); then
            DNSNOTE=""
            if [ -n "$KS" ]; then vpn_dns_on; else vpn_dns_off; fi
            KS="$KS$DNSNOTE"
            ENDPOINT=$(wg show "$WG_IFACE" endpoints 2>/dev/null | awk "{print \$2}" | head -n1)
            # wg-quick is done once the interface is there, whether or not
            # the server answers: it's connected only when the server has
            # (a handshake), so wait a few seconds for one. WireGuard only
            # makes one once something goes through: a probe does.
            ping -c 1 -W 1 "$(probe_address)" >/dev/null 2>&1 &
            n=0
            while [ "$n" -lt 8 ]; do
                [ "$(wg show "$WG_IFACE" latest-handshakes 2>/dev/null | awk '$2 > 0' | wc -l)" -gt 0 ] && break
                sleep 1
                n=$((n + 1))
            done
            if [ "$n" -ge 8 ]; then
                # Left up: with the tunnel there nothing leaks out around it.
                set_status "no_answer" "No answer from the VPN server${ENDPOINT:+ ($ENDPOINT)}. Is this config also in use on another PC? Each needs its own.$KS" "$WG_IFACE"
                echo "ferro-vpn: the tunnel is up, but no handshake from ${ENDPOINT:-the server}: is this config in use on another PC (each needs its own keys), is UDP to it blocked on this network, or is the clock wrong?" >&2
                exit 0
            fi
            DETAIL="WireGuard tunnel is active ($WG_IFACE)"
            [ -n "$ENDPOINT" ] && DETAIL="Connected ($ENDPOINT)"
            set_status "connected" "$DETAIL.$KS" "$WG_IFACE"
            echo "ferro-vpn: WireGuard connected ($WG_IFACE).$KS"
            exit 0
        else
            # What wg-quick said, as the reason: "RTNETLINK answers: File
            # exists" is a route this network already has (its addresses
            # overlap the VPN's), "resolvconf: command not found" its DNS.
            WHY=$(printf '%s\n' "$OUT" | grep -v '^\[#\]' | tail -n1)
            printf '%s\n' "$OUT" >&2
            wg-quick down "$WG_CONF" >/dev/null 2>&1 || ip link delete dev "$WG_IFACE" 2>/dev/null || true
            vpn_dns_off
            case "$WHY" in
                *"File exists"*) WHY="This network's addresses overlap the VPN's (a route is already there)." ;;
                "") WHY="Failed to start WireGuard tunnel" ;;
                *) WHY="Couldn't start WireGuard: $WHY" ;;
            esac
            # The VPN is still wanted: with the kill switch, nothing goes
            # out until it's working or switched off.
            if killswitch_active; then
                set_status "blocked" "$WHY The internet is blocked until the VPN works or is switched off (kill switch)." ""
            else
                set_status "error" "$WHY" ""
            fi
            echo "ferro-vpn: failed to start WireGuard" >&2
            exit 1
        fi
        ;;

    off)
        rm -f "$REMEMBER"
        wg-quick down "$WG_CONF" 2>/dev/null || ip link delete dev "$WG_IFACE" 2>/dev/null || true
        killswitch_off
        vpn_dns_off
        set_status "disconnected" "WireGuard is disconnected." ""
        echo "ferro-vpn: WireGuard disconnected"
        exit 0
        ;;

    status)
        if ip link show dev "$WG_IFACE" >/dev/null 2>&1 && wg show "$WG_IFACE" >/dev/null 2>&1; then
            ENDPOINT=$(wg show "$WG_IFACE" endpoints 2>/dev/null | awk "{print \$2}" | head -n1)
            DETAIL="WireGuard tunnel is active ($WG_IFACE)"
            [ -n "$ENDPOINT" ] && DETAIL="Connected ($ENDPOINT)"
            if killswitch_active; then DETAIL="$DETAIL. Kill switch on."; else DETAIL="$DETAIL. No kill switch."; fi
            [ -f "$VPN_DNS" ] && DETAIL="$DETAIL Lookups through the VPN's DNS."
            set_status "connected" "$DETAIL" "$WG_IFACE"
            echo "state=connected"
            echo "detail=$DETAIL"
            echo "interface=$WG_IFACE"
        elif [ -f "$REMEMBER" ] && killswitch_active; then
            DETAIL="The VPN dropped: the internet is blocked until it's back (kill switch). Switch the VPN off to go online without it."
            set_status "blocked" "$DETAIL" ""
            echo "state=blocked"
            echo "detail=$DETAIL"
        else
            CFG=$(find_config)
            if [ -n "$CFG" ]; then
                set_status "ready" "Config ready ($CFG). Click Apply to connect." ""
                echo "state=ready"
                echo "detail=Config ready ($CFG). Click Apply to connect."
            else
                set_status "no_config" "Place config in /etc/ferro/vpn.conf" ""
                echo "state=no_config"
                echo "detail=Place config in /etc/ferro/vpn.conf"
            fi
        fi
        ;;

    restore)
        # Left on: the kill switch before the network comes up (this runs
        # before it), then the tunnel, which connects once there's a network.
        [ -f "$REMEMBER" ] || { set_status "disconnected" "WireGuard is disconnected." ""; exit 0; }
        SERVERS=$(grep -E "$ADDR" "$REMEMBER")
        ID=$(using_id)
        # Its own servers for its endpoints (each config's port may be the same).
        OWN=$(grep -E "$ADDR" "$CACHE/$ID" 2>/dev/null)
        [ -n "$OWN" ] || OWN=$SERVERS
        CFG=$CONF
        [ -z "$ID" ] || CFG=$LIST/$ID.conf
        # The tunnel's config made again from the VPN's own (/etc/ferro/vpn.conf,
        # what Import keeps), as `on` makes it: startup doesn't depend on a
        # copy in /etc/wireguard having survived. No lookups here (nothing is
        # up yet): the server addresses from last time.
        mkdir -p /etc/wireguard
        chmod 700 /etc/wireguard
        if [ -s "$CFG" ] && install_config "/etc/wireguard/.$WG_IFACE.new" <"$CFG"; then
            pin_endpoints "/etc/wireguard/.$WG_IFACE.new" "$OWN"
            mv -f "/etc/wireguard/.$WG_IFACE.new" "$WG_CONF"
        fi
        if killswitch_wanted && [ -f "$WG_CONF" ] && full_tunnel "$WG_CONF"; then
            # Without the server's address, nothing gets out at all: better
            # than everything getting out around the tunnel.
            killswitch_on "$SERVERS" || killswitch_on ""
        fi
        if [ -f "$WG_CONF" ] && command -v wg-quick >/dev/null 2>&1 && wg-quick up "$WG_CONF" >/dev/null 2>&1; then
            killswitch_active && vpn_dns_on
            set_status "connecting" "Connecting to the VPN..." "$WG_IFACE"
        else
            set_status "error" "The VPN couldn't be started again after the restart." ""
        fi
        exit 0
        ;;

    reapply)
        # The firewall service was (re)started, which clears every rule.
        if [ -f "$REMEMBER" ] && killswitch_wanted && [ -f "$WG_CONF" ] && full_tunnel "$WG_CONF"; then
            killswitch_on "$(grep -E '^[0-9a-fA-F:.]+ [0-9]+$' "$REMEMBER")"
        fi
        exit 0
        ;;

    killswitch)
        mkdir -p -m 755 "${KS_OFF%/*}"
        if [ "$SWITCH" = off ]; then
            : >"$KS_OFF"
            killswitch_off
            vpn_dns_off
            echo "ferro-vpn: kill switch off: if the VPN drops, traffic goes out directly."
        else
            rm -f "$KS_OFF"
            echo "ferro-vpn: kill switch on (from the next time the VPN is switched on)."
            if [ -f "$REMEMBER" ] && [ -f "$WG_CONF" ] && full_tunnel "$WG_CONF"; then
                if killswitch_on "$(grep -E '^[0-9a-fA-F:.]+ [0-9]+$' "$REMEMBER")"; then
                    echo "ferro-vpn: and on now."
                    ip link show dev "$WG_IFACE" >/dev/null 2>&1 && vpn_dns_on
                fi
            fi
        fi
        exit 0
        ;;

    import)
        # /etc/ferro stays root's alone: root trusts what's in it.
        mkdir -p -m 755 /etc/ferro "$LIST"
        mkdir -p /etc/wireguard
        chmod 700 /etc/wireguard
        BEFORE=$(ids)
        # Its name: letters, digits, - and _ (from the file's name).
        NAME=$(printf '%s' "$SWITCH" | sed 's/\.[A-Za-z]*$//' | tr -c 'A-Za-z0-9_-' '-' | sed 's/--*/-/g; s/^-//; s/-$//' | cut -c1-40)
        [ -n "$NAME" ] || NAME=vpn
        LAST=$(printf '%s\n' "$BEFORE" | sed -n 's/^\([0-9][0-9]\)-.*/\1/p' | sort -n | tail -n1)
        NUM=$(printf '%02d' $((${LAST:-0} + 1)))
        if [ "$NUM" -gt 99 ]; then
            echo "ferro-vpn: the list is full (99 configs): remove one first" >&2
            exit 1
        fi
        TMP=$LIST/.new.conf
        if ! install_config "$TMP"; then
            rm -f "$TMP"
            echo "ferro-vpn: what was given isn't a WireGuard config (no [Interface] section)" >&2
            exit 1
        fi
        for id in $BEFORE; do
            if cmp -s "$TMP" "$LIST/$id.conf"; then
                rm -f "$TMP"
                echo "ferro-vpn: that config is already on the list ($(name_of "$id"))"
                exit 0
            fi
        done
        ID=$NUM-$NAME
        mv -f "$TMP" "$LIST/$ID.conf"
        # Its servers, looked up while that's possible.
        S=$(servers "$LIST/$ID.conf")
        [ -z "$S" ] || { mkdir -p -m 700 "$CACHE" && printf '%s\n' "$S" >"$CACHE/$ID"; }
        COUNT=$(ids | wc -l)
        echo "ferro-vpn: added $NAME to the list ($COUNT configs)"
        if [ -z "$BEFORE" ]; then
            # The first: the one used.
            set_using "$ID"
            install_config "$CONF" <"$LIST/$ID.conf" || true
            install_config "$WG_CONF" <"$CONF" || true
            if [ -f "$REMEMBER" ]; then "$0" on >/dev/null 2>&1 || true; else set_status "ready" "Imported. Click Apply to connect." ""; fi
        elif [ -f "$REMEMBER" ]; then
            # The VPN is on: its kill switch lets this server be reached too.
            # And if what's in use isn't working, this one's tried at once.
            state=$(sed -n 's/^state=//p' "$STATUS" 2>/dev/null)
            if [ "$state" = connected ]; then
                all_servers "$(servers "$WG_CONF")" >"$REMEMBER"
                killswitch_active && killswitch_on "$(cat "$REMEMBER")"
            else
                set_using "$ID"
                "$0" on >/dev/null 2>&1 || true
            fi
        fi
        exit 0
        ;;

    list)
        u=$(using_id)
        for id in $(ids); do
            if [ "$id" = "$u" ]; then echo "$id in-use"; else echo "$id"; fi
        done
        exit 0
        ;;

    use)
        [ -f "$LIST/$SWITCH.conf" ] || { echo "ferro-vpn: no config $SWITCH on the list" >&2; exit 1; }
        set_using "$SWITCH"
        echo "ferro-vpn: using $(name_of "$SWITCH")"
        if [ -f "$REMEMBER" ]; then exec "$0" on; fi
        install_config "$CONF" <"$LIST/$SWITCH.conf" || true
        set_status "ready" "Using $(name_of "$SWITCH"). Click Apply to connect." ""
        exit 0
        ;;

    remove)
        [ -f "$LIST/$SWITCH.conf" ] || { echo "ferro-vpn: no config $SWITCH on the list" >&2; exit 1; }
        WAS=$(using_id)
        NEXT=$(next_id "$SWITCH")
        rm -f "$LIST/$SWITCH.conf" "$CACHE/$SWITCH"
        echo "ferro-vpn: removed $(name_of "$SWITCH")"
        if ! ls "$LIST"/[0-9][0-9]-*.conf >/dev/null 2>&1; then
            # None left: the VPN off, and no config (not even the one from
            # before the list, which would come back as its first).
            rm -f "$USING" "$CONF" "$WG_CONF"
            [ ! -f "$REMEMBER" ] || exec "$0" off
            set_status "no_config" "Place config in /etc/ferro/vpn.conf" ""
        elif [ "$WAS" = "$SWITCH" ]; then
            set_using "$NEXT"
            if [ -f "$REMEMBER" ]; then exec "$0" on; fi
            install_config "$CONF" <"$LIST/$NEXT.conf" || true
        elif [ -f "$REMEMBER" ]; then
            # Its server no longer let through.
            # (The tunnel's own, as pinned in its config, kept whatever.)
            { servers "$WG_CONF"; for id in $(ids); do cat "$CACHE/$id" 2>/dev/null; done; } | grep -E "$ADDR" | sort -u >"$REMEMBER.new"
            mv -f "$REMEMBER.new" "$REMEMBER"
            killswitch_active && killswitch_on "$(cat "$REMEMBER")"
        fi
        exit 0
        ;;

    watch)
        # The VPN on, its server checked every EVERY seconds: anything back
        # through the tunnel since last time, or after a probe sent through
        # it (a live server answers within 10 seconds: WireGuard's own
        # keepalive, if nothing else). Two checks without: the next config.
        EVERY=${FERRO_VPN_EVERY:-15}
        fails=0
        rx_last=0
        while :; do
            sleep "$EVERY"
            if [ ! -f "$REMEMBER" ]; then fails=0; continue; fi
            # No network at all: no server could answer; nothing to switch.
            if [ -z "$(ip route show default 2>/dev/null | grep -v "dev $WG_IFACE")" ] &&
                [ -z "$(ip -6 route show default 2>/dev/null | grep -v "dev $WG_IFACE")" ]; then
                fails=0
                continue
            fi
            rx=$(wg show "$WG_IFACE" transfer 2>/dev/null | awk '{ n += $2 } END { print n + 0 }')
            if [ -n "$rx" ] && [ "$rx" -gt "$rx_last" ] && ip link show dev "$WG_IFACE" >/dev/null 2>&1; then
                rx_last=$rx
                fails=0
                continue
            fi
            answered=""
            if ip link show dev "$WG_IFACE" >/dev/null 2>&1; then
                ping -c 1 -W 2 "$(probe_address)" >/dev/null 2>&1 &
                n=0
                while [ "$n" -lt 13 ]; do
                    sleep 1
                    rx=$(wg show "$WG_IFACE" transfer 2>/dev/null | awk '{ n += $2 } END { print n + 0 }')
                    if [ "$rx" -gt "$rx_last" ]; then answered=yes; break; fi
                    n=$((n + 1))
                done
                wait
            fi
            rx_last=${rx:-0}
            if [ -n "$answered" ]; then fails=0; continue; fi
            fails=$((fails + 1))
            [ "$fails" -ge 2 ] || continue
            fails=0
            rx_last=0
            [ -f "$REMEMBER" ] || continue
            WAS=$(using_id)
            NEXT=$(next_id "$WAS")
            [ -n "$NEXT" ] || continue
            if [ "$NEXT" != "$WAS" ]; then
                echo "ferro-vpn: no answer from $(name_of "$WAS"): switching to $(name_of "$NEXT")" >&2
                FERRO_VPN_NOTE="$(name_of "$WAS") stopped answering: switched to $(name_of "$NEXT"). " "$0" use "$NEXT" >/dev/null 2>&1
            else
                # Only one: started again (its server's name looked up again).
                echo "ferro-vpn: no answer from $(name_of "$WAS"): starting it again" >&2
                "$0" on >/dev/null 2>&1
            fi
        done
        ;;
esac
