#!/bin/sh
# ferro-install: puts FerroOS Heavy on a disk, from the running installation
# medium, with no network. The disk is erased and gets:
#
#   1. EFI system partition (512 MiB): Debian's signed boot loader, so
#      Secure Boot can stay on
#   2. /boot (1 GiB): the kernel and its start-up image
#   3. everything else: LUKS2, holding the system and your files
#
# It asks which disk, a passphrase for the disk, and a name and password for
# your account. The installer window (ferro-setup) answers those through
# standard input; tests answer through FERRO_DISK, FERRO_PASSPHRASE,
# FERRO_USER and FERRO_PASSWORD.

set -e
IMAGE=/run/live/medium/live/filesystem.squashfs
T=/mnt/ferro-target

die() { echo "ferro-install: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "run it with sudo"
[ -f "$IMAGE" ] || die "this only runs from the FerroOS Heavy installation medium"
[ -d /sys/firmware/efi ] || die "this machine was started in BIOS mode; FerroOS Heavy installs on UEFI machines"

ask() { # ask <variable> <prompt> [hidden]
    eval "v=\${$1:-}"
    if [ -z "$v" ]; then
        printf '%s' "$2"
        # (No terminal to hush when the installer window is answering.)
        hush=
        [ -n "$3" ] && [ -t 0 ] && hush=1
        [ -n "$hush" ] && stty -echo
        # Exactly what was typed: spaces at either end are part of it.
        IFS= read -r v
        [ -n "$hush" ] && { stty echo; echo; }
    fi
    eval "$1=\$v"
}

if [ -z "$FERRO_DISK" ]; then
    echo "Disks in this machine:"
    lsblk -d -n -o NAME,SIZE,MODEL -e 7,11 | sed 's/^/  /'
    echo
fi
ask FERRO_DISK "Install on which disk (for example sda or nvme0n1)? Everything on it is erased: "
DISK=/dev/${FERRO_DISK#/dev/}
[ -b "$DISK" ] || die "$DISK is not a disk"
MEDIUM=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || true)
case "$MEDIUM" in "$DISK"*) die "$DISK is the installation medium" ;; esac

if [ -z "$FERRO_ENCRYPT" ]; then
    ask FERRO_ENCRYPT "Encrypt the disk with LUKS2 (Y/N, default Y)? "
    [ -z "$FERRO_ENCRYPT" ] && FERRO_ENCRYPT=Y
fi
case "$FERRO_ENCRYPT" in
    [nN]*) ENCRYPT=0 ;;
    *) ENCRYPT=1 ;;
esac

if [ "$ENCRYPT" = "1" ]; then
    if [ -z "$FERRO_PASSPHRASE" ]; then
        ask FERRO_PASSPHRASE "Passphrase for the disk (asked at every start; nothing can recover it): " hidden
        ask AGAIN "Again: " hidden
        [ "$FERRO_PASSPHRASE" = "$AGAIN" ] || die "the passphrases differ"
    fi
    # Against someone with a lab and time: long enough that guessing it,
    # even at a GPU farm's pace, takes longer than it matters.
    [ ${#FERRO_PASSPHRASE} -ge 12 ] || die "use at least 12 characters for the disk passphrase"
    if [ -z "$FERRO_DURESS" ]; then
        ask FERRO_DURESS "Duress PIN (optional; - for none): " hidden
        [ "$FERRO_DURESS" = "-" ] && FERRO_DURESS=
    fi
    if [ -n "$FERRO_DURESS" ]; then
        [ "$FERRO_DURESS" != "$FERRO_PASSPHRASE" ] || die "the duress PIN must differ from the passphrase"
        # Its hash sits on the unencrypted boot partition (it has to be
        # checked before the disk is unlocked): a short PIN would be guessed
        # from a copy of the disk, and its owner known to avoid it.
        [ ${#FERRO_DURESS} -ge 10 ] || die "use at least 10 characters for the duress PIN"
    fi
else
    FERRO_PASSPHRASE=
    FERRO_DURESS=
fi
ask FERRO_USER "Your account's name (lower-case letters and digits): "
echo "$FERRO_USER" | grep -Eq '^[a-z][a-z0-9_-]{0,30}$' || die "that name won't work as an account name"
if [ -z "$FERRO_PASSWORD" ]; then
    ask FERRO_PASSWORD "Password for $FERRO_USER: " hidden
    # (Empty again: it still holds the passphrase's second typing.)
    AGAIN=
    ask AGAIN "Again: " hidden
    [ "$FERRO_PASSWORD" = "$AGAIN" ] || die "the passwords differ"
fi
if [ -z "$FERRO_YES" ]; then
    printf 'Erase %s and install FerroOS Heavy on it? Type ERASE to go on: ' "$DISK"
    IFS= read -r answer
    [ "$answer" = ERASE ] || die "nothing was changed"
fi

# Partition names: sda1, but nvme0n1p1.
case "$DISK" in *[0-9]) P=${DISK}p ;; *) P=$DISK ;; esac

echo "== partitioning $DISK"
wipefs -a -q "$DISK"
sgdisk --zap-all "$DISK" >/dev/null
sgdisk -n1:0:+512M -t1:ef00 -c1:"EFI system" -n2:0:+1G -t2:8300 -c2:ferro-boot -n3:0:0 -t3:8309 -c3:ferro-system "$DISK" >/dev/null
partprobe "$DISK" 2>/dev/null || true
udevadm settle 2>/dev/null || sleep 2
mkfs.vfat -F32 -n FERROEFI "${P}1" >/dev/null
mkfs.ext4 -q -F -L ferro-boot "${P}2"

if [ "$ENCRYPT" = "1" ]; then
    echo "== encrypting (LUKS2)"
    # Argon2id with 1 GiB of memory and 5 s of work per try (capped at half
    # this machine's memory): each guess at the passphrase costs the same.
    printf '%s' "$FERRO_PASSPHRASE" | cryptsetup luksFormat --type luks2 --pbkdf argon2id \
        --pbkdf-memory 1048576 --pbkdf-parallel 4 --iter-time 5000 --batch-mode --key-file - "${P}3"
    printf '%s' "$FERRO_PASSPHRASE" | cryptsetup open --key-file - "${P}3" ferro-system
    ROOT_DEV=/dev/mapper/ferro-system
else
    echo "== formatting system"
    ROOT_DEV="${P}3"
fi
mkfs.ext4 -q -F -L ferro-system "$ROOT_DEV"

echo "== copying the system"
mkdir -p "$T"
mount "$ROOT_DEV" "$T"
mkdir -p "$T/boot"
mount "${P}2" "$T/boot"
mkdir -p "$T/boot/efi"
mount "${P}1" "$T/boot/efi"
unsquashfs -f -n -d "$T" "$IMAGE" >/dev/null

echo "== setting it up to start from the disk"
cat >"$T/etc/fstab" <<EOF
$ROOT_DEV / ext4 errors=remount-ro,noatime 0 1
UUID=$(blkid -s UUID -o value "${P}2") /boot ext4 nodev,nosuid,noexec,noatime 0 2
UUID=$(blkid -s UUID -o value "${P}1") /boot/efi vfat umask=0077 0 2
EOF
if [ "$ENCRYPT" = "1" ]; then
    # With a duress PIN, unlock-disk asks for the passphrase at startup so
    # the PIN works there too, not only at the logon screen.
    OPTS=luks
    [ -n "$FERRO_DURESS" ] && OPTS=luks,keyscript=/usr/local/lib/ferro-heavy/unlock-disk
    echo "ferro-system UUID=$(blkid -s UUID -o value "${P}3") none $OPTS" >"$T/etc/crypttab"
else
    rm -f "$T/etc/crypttab"
fi
# What the programs run inside the copy need to see of the machine. Each is
# mounted by itself (not the running system's whole tree of them), so each
# can be unmounted again at the end.
mount -t proc proc "$T/proc"
mount -t sysfs sys "$T/sys"
mount -t efivarfs efivarfs "$T/sys/firmware/efi/efivars" 2>/dev/null || true
mount --bind /dev "$T/dev"
# Ours alone: unmounting it later must not unmount the running system's.
mount --make-private "$T/dev"
mount -t devpts devpts "$T/dev/pts"
# Tests drive the installed system over the serial line (FERRO_TEST_SERIAL=1).
if [ -n "$FERRO_TEST_SERIAL" ]; then
    echo 'GRUB_CMDLINE_LINUX="console=tty0 console=ttyS0,115200"' >"$T/etc/default/grub.d/99-test-serial.cfg"
fi
if [ -n "$FERRO_DURESS" ]; then
    echo "== configuring duress PIN"
    mkdir -p "$T/etc/ferro"
    # Argon2id, salted: about a second and 256 MiB per guess.
    salt=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
    hash=$(printf '%s' "$FERRO_DURESS" | argon2 "$salt" -id -t 3 -m 18 -p 1 -l 32 -r) || die "couldn't protect the duress PIN"
    echo "argon2id 3 18 $salt $hash" >"$T/etc/ferro/duress.hash"
    chmod 600 "$T/etc/ferro/duress.hash"
fi
# The name and password travel in the environment, never in the script text.
FERRO_USER="$FERRO_USER" FERRO_PASSWORD="$FERRO_PASSWORD" chroot "$T" /bin/sh -e <<'EOF'
export DEBIAN_FRONTEND=noninteractive PATH=/usr/sbin:/usr/bin:/sbin:/bin
# What only the installation medium needs.
dpkg --purge live-boot live-boot-initramfs-tools >/dev/null 2>&1 || true
systemctl disable ferro-live.service >/dev/null 2>&1 || true
rm -f /usr/local/share/applications/ferro-install.desktop
useradd -m -s /bin/bash -G sudo,video,render,audio,input "$FERRO_USER"
printf '%s:%s\n' "$FERRO_USER" "$FERRO_PASSWORD" | chpasswd
update-initramfs -u -k all >/dev/null
grub-install --target=x86_64-efi --efi-directory=/boot/efi --uefi-secure-boot >/dev/null 2>&1
# And where firmware looks when it has no entry for us.
grub-install --target=x86_64-efi --efi-directory=/boot/efi --uefi-secure-boot --removable --no-nvram >/dev/null 2>&1
update-grub >/dev/null 2>&1
EOF

echo "== finishing"
umount "$T/sys/firmware/efi/efivars" 2>/dev/null || true
umount "$T/dev/pts" "$T/dev" "$T/sys" "$T/proc" "$T/boot/efi" "$T/boot" "$T"
if [ "$ENCRYPT" = "1" ]; then
    cryptsetup close ferro-system
fi
sync
echo "FerroOS Heavy is installed on $DISK. Take out the installation medium and restart."
