# FerroOS kernel fragment, merged on top of `make tinyconfig`.
#
# The balanced approach: the core that every boot needs is built in; device
# drivers are loadable modules (=m). A driver for hardware you don't have
# stays on disk and costs no RAM. init loads only what /etc/modules lists.
#
# Hardware beyond QEMU (Intel/AMD GPUs, Wi-Fi, ...) lives in ferro-hw.config,
# merged when building with FERRO_KERNEL_HW=1.

# ---- Core (built in) --------------------------------------------------------
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
# No symbol table: saves about 1 MB of kernel image and gives attackers
# no function addresses. Oopses print raw addresses instead.
# CONFIG_KALLSYMS is not set
# Smaller kernel hash tables and limits, sized for a desktop, not a server.
CONFIG_BASE_SMALL=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
# flock/fcntl locks: SQLite and the Tor service need them.
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_PROC_SYSCTL=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SMP=y
# tinyconfig's default is two processors.
CONFIG_NR_CPUS=64
# Firmware on big machines hands over in x2APIC mode, and a kernel without
# it stops at boot.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_X86_X2APIC=y
# Write-combining for the screen: without it every pixel written to a
# firmware framebuffer (simpledrm) is an uncached write.
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
# Report hardware errors instead of resetting silently.
CONFIG_X86_MCE=y
CONFIG_X86_MCE_AMD=y
CONFIG_X86_MCE_INTEL=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
# UEFI: firmware hands over the screen (simpledrm), and FerroOS's boot
# loader starts the kernel through its EFI stub.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# Setup adds FerroOS to the firmware's boot menu (UEFI variables).
CONFIG_EFIVAR_FS=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_INPUT=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLOCK=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# cgroup v2: per-app RAM budgets and process limits for the sandbox
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y

# ---- Loadable modules -------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Modules ship zstd-compressed and the kernel unpacks them itself, so
# drivers kept for hotplug cost a third of the RAM.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_STRICT_MODULE_RWX=y

# Display: DRM/KMS core plus QEMU and firmware-framebuffer drivers.
# No fbdev emulation or framebuffer text console: they keep a second
# full-screen buffer (4 MB at 1280x800, 8 MB at 1080p) that the desktop never
# shows. The rescue console runs over serial; simpledrm covers firmware
# framebuffers.
CONFIG_DRM=m
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_SIMPLEDRM=m
# QEMU's Cirrus adapter: scans out 16-bit, which tests the High Color path.
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_SYSFB_SIMPLEFB=y

# Input
CONFIG_INPUT_EVDEV=m
CONFIG_INPUT_MOUSEDEV=m
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=m
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_SUPPORT=y
CONFIG_USB=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_HID=m
# Installing from (and saving to) USB sticks.
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m

# Storage: virtio, NVMe, SATA; case-folding ext4 for Windows-style names.
CONFIG_VIRTIO_BLK=m
CONFIG_BLK_DEV_NVME=m
CONFIG_ATA=m
CONFIG_SATA_AHCI=m
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_EXT4_FS=m
CONFIG_UNICODE=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_VERITY=m
# The Debian layer (glibc and its programs): a read-only compressed image
# mounted on /usr, loaded only when the layer is there.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
# What you install into Debian goes on top of that image (overlayfs): in RAM,
# or on the disk's LUKS2 partition (dm-crypt, ext4). Nothing here autoloads
# modules, so the ciphers LUKS2 asks for by name are built in.
CONFIG_OVERLAY_FS=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
# overlayfs marks deleted and replaced folders with extended attributes,
# also when the top is in RAM.
CONFIG_TMPFS_XATTR=y
# System calls ordinary Linux programs expect to exist.
CONFIG_ADVISE_SYSCALLS=y
CONFIG_INOTIFY_USER=y
CONFIG_MEMBARRIER=y

# Network (for the planned Rust network daemon)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=m
CONFIG_E1000E=m
# The wired cards on most current boards (Realtek 1G/2.5G, Intel 2.5G).
CONFIG_R8169=m
CONFIG_IGC=m
# No 6in4 tunnel device (sit0) that looks like a network card.
# CONFIG_IPV6_SIT is not set

# Wi-Fi: the stack and the cards in most current machines. Their firmware
# files come from the Debian layer (/usr/lib/firmware), so the drivers are
# loaded once that's mounted, not at boot. Nothing here autoloads modules,
# so the ciphers WPA asks for by name are built in.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_RFKILL=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_FW_LOADER=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GHASH=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# A simulated radio, for testing Wi-Fi in a VM.
CONFIG_MAC80211_HWSIM=m
CONFIG_PACKET=m
CONFIG_WIREGUARD=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
# Routing by user (FIB rules with uid ranges): in Tor mode only the Tor
# service has a route to the internet, so nothing else can go around it.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# ---- No traces: memory is never written to disk ------------------------------
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_COREDUMP is not set
# A 16 KB kernel log ring in RAM is plenty with a serial console.
CONFIG_LOG_BUF_SHIFT=14

# ---- Hardening (cheap in RAM) ------------------------------------------------
# Devices get only the memory they're given (IOMMU): a rogue PCI,
# Thunderbolt or USB4 device can't read or write the rest of RAM.
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_IRQ_REMAP=y
# Only modules signed by this build's throwaway key can load.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
# tinyconfig switches off the prerequisites, so they are restored first.
CONFIG_STACKPROTECTOR=y
CONFIG_RELOCATABLE=y
CONFIG_CPU_MITIGATIONS=y
# CONFIG_SLUB_TINY is not set
# No slab debugging code or its sysfs files.
# CONFIG_SLUB_DEBUG is not set
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LSM="landlock,lockdown,yama"
# Lockdown is built in, not a boot option that could be edited away.
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
# CONFIG_PROC_KCORE is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_LEGACY_TIOCSTI is not set
