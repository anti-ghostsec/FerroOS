# Real-hardware drivers, all modules. Merged when FERRO_KERNEL_HW=1.
# They add build time but no RAM unless the hardware is present and listed
# in /etc/modules.

CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_R8169=m
CONFIG_IGB=m
CONFIG_USB_STORAGE=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_MEDIA_SUPPORT=m
